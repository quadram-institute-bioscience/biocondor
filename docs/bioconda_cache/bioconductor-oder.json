{"name": "bioconductor-oder", "id": "618af2e239552dcb59715183", "package_types": ["conda"], "summary": "Optimising the Definition of Expressed Regions", "description": "The aim of ODER is to identify previously unannotated expressed regions (ERs) using RNA-sequencing data. For this purpose, ODER defines and optimises the definition of ERs, then connected these ERs to genes using junction data. In this way, ODER improves gene annotation. Gene annotation is a staple input of many bioinformatic pipelines and a more complete gene annotation can enable more accurate interpretation of disease associated variants.", "home": "https://bioconductor.org/packages/3.14/bioc/html/ODER.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-oder", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-oder", "html_url": "http://anaconda.org/bioconda/bioconductor-oder", "versions": ["1.0.0", "1.4.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 6, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 3865, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-oder/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-oder/1.4.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-oder/1.6.0"}], "watchers": 1, "upvoted": 0, "created_at": "2021-11-09 22:14:58.238000+00:00", "modified_at": "2025-