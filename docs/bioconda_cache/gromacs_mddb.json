{"name": "gromacs_mddb", "id": "68f0c4b93d4a0a11a2998df0", "package_types": ["conda"], "summary": "GROMACS is a versatile package to perform molecular dynamics.", "description": "Development version of GROMACS in colaboration to MDDB to add the\npossibility to export tpr to json.\n\nGROMACS is a versatile package to perform molecular dynamics, i.e.\nsimulate the Newtonian equations of motion for systems with hundreds\nto millions of particles. It is primarily designed for biochemical\nmolecules like proteins, lipids and nucleic acids that have a lot of\ncomplicated bonded interactions, but since GROMACS is extremely fast\nat calculating the nonbonded interactions (that usually dominate\nsimulations) many groups are also using it for research on\nnon-biological systems, e.g. polymers.\n", "home": "https://www.gromacs.org/", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/gromacs_mddb", "url": "http://api.anaconda.org/packages/bioconda/gromacs_mddb", "html_url": "http://anaconda.org/bioconda/gromacs_mddb", "versions": ["2025.3"], "latest_version": "2025.3", "platforms": {"linux-64": "2025.3"}, "conda_platforms": ["linux-64"], "revision": 6, "license": "LGPL-2.1-or-later", "license_url": null, "dev_url": "https://gitlab.com/gromacs/gromacs/-/tree/pj_mddb_json_proto-2025", "doc_url": "https://manual.gromacs.org/", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h61c8354_2", "h61c8354_3", "h61c8354_0", "h61c8354_1"], "ndownloads": 919, "releases": [{"version": "2025.3", "distributions": [], "full_name": "bioconda/gromacs_mddb/2025.3"}], "watchers": 1, "upvoted": 0, "created_at": "2025-10-16 10:11:05.6420