{"name": "bioconductor-syntenet", "id": "6368669cbdd024375c066ce4", "package_types": ["conda"], "summary": "Inference And Analysis Of Synteny Networks", "description": "syntenet can be used to infer synteny networks from whole-genome protein sequences and analyze them. Anchor pairs are detected with the MCScanX algorithm, which was ported to this package with the Rcpp framework for R and C++ integration. Anchor pairs from synteny analyses are treated as an undirected unweighted graph (i.e., a synteny network), and users can perform: i. network clustering; ii. phylogenomic profiling (by identifying which species contain which clusters) and; iii. microsynteny-based phylogeny reconstruction with maximum likelihood.", "home": "https://bioconductor.org/packages/3.16/bioc/html/syntenet.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-syntenet", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-syntenet", "html_url": "http://anaconda.org/bioconda/bioconductor-syntenet", "versions": ["1.0.0", "1.2.4", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"linux-64": "1.8.0", "osx-64": "1.8.0"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 10, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44he5774e6_0", "r42hf17093f_1", "r43hc0ef7c4_0", "r42hb890f52_0", "r43hf17093f_0", "r42hc247a5b_0", "r44h35d7169_0", "r42hc0ef7c4_1"], "ndownloads": 5997, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-syntenet/1.0.0"}, {"version": "1.2.4", "distributions":