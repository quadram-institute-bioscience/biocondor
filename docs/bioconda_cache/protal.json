{"name": "protal", "id": "688941792e8f009a2b98841a", "package_types": ["conda"], "summary": "Reference-based metagenomic analysis.", "description": "Protal is a computational tool for taxonomic profiling and strain-resolved analyses of bacterial communities from\nmetagenomic shotgun sequencing data (short-reads). Following a reference-based approach, protal uses the same\n120 universal marker genes GTDB uses to build their phylogeny (TIGRFAM, PFAM) and thus integrates well with other\n120 universal marker genes GTDB uses to build their phylogeny (TIGRFAM, PFAM) and thus integrates well with other\ntools working in the GTDB taxonomy space.\n", "home": "https://github.com/4less/protal", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/protal", "url": "http://api.anaconda.org/packages/bioconda/protal", "html_url": "http://anaconda.org/bioconda/protal", "versions": ["0.1.0a", "0.2.0a", "0.2.1a"], "latest_version": "0.2.1a", "platforms": {"linux-64": "0.2.1a"}, "conda_platforms": ["linux-64"], "revision": 9, "license": "MIT", "license_url": null, "dev_url": "https://github.com/4less/protal", "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h5ca1c30_0"], "ndownloads": 598, "releases": [{"version": "0.1.0a", "distributions": [], "full_name": "bioconda/protal/0.1.0a"}, {"version": "0.2.0a", "distributions": [], "full_name": "bioconda/protal/0.2.0a"}, {"version": "0.2.1a", "distributions": [], "full_name": "bioconda/protal/0.2.1a"}], "watchers": 1, "upvoted": 0, "created_at": "2025-07-29 21:47:37.309000+00:00", "modified_at": "2025-11-05 17:05:02.669000+00:00", "files": [{"description": null, 