{"name": "selam", "id": "62d61c76d84371b86bebb507", "package_types": ["conda"], "summary": "Simulation of Epistasis Local adaptation, with Ancestry and Mate choice", "description": "SELAM (Simulation of Epistasis, Local adaptation with Admixture and Mate\nchoice) is a forward time population genetic simulation for studying\nadmixture between ancestral subpopulations. This program tracks local\nancestry along chromosomes. SELAM supports complex demography\nscenarios, including changes in population sizes, migration rates, and\narbitrary numbers of subpopulations. This program can also accommodate\nsophisticated selective regimes, including dominance, epistasis, local\nadaptation, and mate choice.\n", "home": "https://github.com/russcd/SELAM/", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/selam", "url": "http://api.anaconda.org/packages/bioconda/selam", "html_url": "http://anaconda.org/bioconda/selam", "versions": ["0.9"], "latest_version": "0.9", "platforms": {"linux-64": "0.9", "osx-64": "0.9", "linux-aarch64": "0.9"}, "conda_platforms": ["linux-64", "linux-aarch64", "osx-64"], "revision": 8, "license": "GPL3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h0432e7c_1", "h9419716_3", "h4d91bc5_3", "h0432e7c_3", "h5e66344_0", "h0432e7c_2", "h601eabb_1", "h0b6e359_0", "h337ff5c_4", "h4d91bc5_2", "h3053a90_4", "hc71ec12_4", "h5e66344_1"], "ndownloads": 3510, "releases": [{"version": "0.9", "distributions": [], "full_name": "bioconda/selam/0.9"}], "watchers": 1, "upvoted": 0, "created_at": "2022-07-19 02:52:38.698000+00:00", "modified_at": "2025