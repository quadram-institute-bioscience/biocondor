{"name": "density-fitness", "id": "6946fc1bfd3a29a8a3290e4e", "package_types": ["conda"], "summary": "Application to calculate the density statistics (RSR, SRSR, RSCCS, EDIAm and OPIA) for x-ray structures", "description": "The program density-fitness calculates electron density metrics, for main- (includes C\u03b2 atom) and side-chain atoms of individual residues.\nFor this calculation, the program uses the structure model in either PDB or mmCIF format and the electron density from the 2mFo-DFc and mFo-DFc maps. If these maps are not readily available, the MTZ file and model can be used to calculate maps clipper. Density-fitness support both X-ray and electron diffraction data.\nThis program is essentially a reimplementation of _edstats_, a program available from the CCP4 suite. However, the output now contains only the RSR, SRSR and RSCC fields as in _edstats_ with the addition of EDIAm and OPIA and no longer requires pre-calculated map coefficients.\n", "home": "https://github.com/PDB-REDO/density-fitness", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/density-fitness", "url": "http://api.anaconda.org/packages/bioconda/density-fitness", "html_url": "http://anaconda.org/bioconda/density-fitness", "versions": ["1.2.0"], "latest_version": "1.2.0", "platforms": {"osx-arm64": "1.2.0", "linux-64": "1.2.0", "osx-64": "1.2.0", "linux-aarch64": "1.2.0"}, "conda_platforms": ["osx-arm64", "osx-64", "linux-aarch64", "linux-64"], "revision": 6, "license": "BSD-2-Clause", "license_url": null, "dev_url": "https://github.com/PDB-REDO/density-fitness", "doc_url": "https://github.com/PDB-REDO/density-fitness/blob/v1.2.0/doc/density-fitness.pdf", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h1e84f2d_0", "h75ae26a_0", "hb844854_0", "h077b44d_0"], "ndownloads": 485, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/density-fitness/1.2.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-12-20 19:42:19.944000+00:00", "modified_at": "2025-12-21 00:27:59.297000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "osx-arm64/density-fitness-1.2.0-hb844854_0.conda", "attrs": {"operatingsystem": "darwin", "machine": "arm64", "target-triplet": "arm64-any-darwin", "has_prefix": false, "subdir": "osx-arm64", "arch": "arm64", "build": "hb844854_0", "build_number": 0, "depends": ["__osx >=13.3", "libcifpp >=9.0.5,<10.0a0", "libcxx >=18", "libpdb-redo >=3.3.1,<4.0a0", "libzlib >=1.3.1,<2.0a0"], "license": "BSD-2-Clause", "license_family": "BSD", "platform": "osx", "timestamp": 1766250951951}, "upload_time": "2025-12-20 19:42:20.495000+00:00", "md5": "f496a22b7a3fea25b2b7487d92078626", "sha256": "bc3aaf1a63bcf361e5027b5fe1fdca858a5947bdec511bf7315fa01ff1266402", "size": 77214, "full_name": "bioconda/density-fitness/1.2.0/osx-arm64/density-fitness-1.2.0-hb844854_0.conda", "download_url": "//api.anaconda.org/download/bioconda/density-fitness/1.2.0/osx-arm64/density-fitness-1.2.0-hb844854_0.conda", "type": "conda", "version": "1.2.0", "ndownloads": 28, "owner": "bioconda", "labels": ["main"]}, {"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "linux-64/density-fitness-1.2.0-h077b44d_0.conda", "attrs": {"operatingsystem": "linux", "machine": "x86_64", "target-triplet": "x86_64-any-linux", "has_prefix": false, "subdir": "linux-64", "arch": "x86_64", "build": "h077b44d_0", "build_number": 0, "depends": ["libcifpp >=9.0.5,<10.0a0", "libgcc >=13", "libpdb-redo >=3.3.1,<4.0a0", "libstdcxx >=13", "libzlib >=1.3.1,<2.0a0"], "license": "BSD-2-Clause", "license_family":