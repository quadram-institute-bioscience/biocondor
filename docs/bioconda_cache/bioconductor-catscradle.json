{"name": "bioconductor-catscradle", "id": "6767f26869a662aa2f57e2da", "package_types": ["conda"], "summary": "This package provides methods for analysing spatial transcriptomics data and for discovering gene clusters", "description": "This package addresses two broad areas.  It allows for in-depth analysis of spatial transcriptomic data by identifying tissue neighbourhoods.  These are contiguous regions of tissue surrounding individual cells.  'CatsCradle' allows for the categorisation of neighbourhoods by the cell types contained in them and the genes expressed in them.  In particular, it produces Seurat objects whose individual elements are neighbourhoods rather than cells.  In addition, it enables the categorisation and annotation of genes by producing Seurat objects whose elements are genes.", "home": "https://bioconductor.org/packages/3.20/bioc/html/CatsCradle.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-catscradle", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-catscradle", "html_url": "http://anaconda.org/bioconda/bioconductor-catscradle", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"noarch": "1.0.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 458, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-catscradle/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2024-12-22 11:05:12.013000+00:00", "modified_at": "2025-04-22 15: