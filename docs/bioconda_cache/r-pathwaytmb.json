{"name": "r-pathwaytmb", "id": "62bea235d84371b86bc8242e", "package_types": ["conda"], "summary": "A systematic bioinformatics tool to develop a new pathway-based gene panel for tumor mutational burden (TMB) assessment (pathway-based tumor mutational burden, PTMB), using somatic mutations files in an efficient manner from either The Cancer Genome Atlas sources or any in-house studies as long as the data is in mutation annotation file (MAF) format. Besides, we develop a multiple machine learning method using the sample's PTMB profiles to identify cancer-specific dysfunction pathways, which can be a biomarker of prognostic and predictive for cancer immunotherapy.", "description": "", "home": "https://CRAN.R-project.org/package=pathwayTMB", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-pathwaytmb", "url": "http://api.anaconda.org/packages/bioconda/r-pathwaytmb", "html_url": "http://anaconda.org/bioconda/r-pathwaytmb", "versions": ["0.1.2", "0.1.3"], "latest_version": "0.1.3", "platforms": {"noarch": "0.1.3"}, "conda_platforms": ["noarch"], "revision": 5, "license": "GPL-2.0-or-later", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44h3121a25_3", "r41h3121a25_0", "r43h3121a25_2", "r42h3121a25_1"], "ndownloads": 4817, "releases": [{"version": "0.1.2", "distributions": [], "full_name": "bioconda/r-pathwaytmb/0.1.2"}, {"version": "0.1.3", "distributions": [], "full_name": "bioconda/r-pathwaytmb/0.1.3"}], "watchers": 1, "upvoted": 0, "created_at": "2022-07-01 07:28:53.718000+00:00", "modified_at": "2025-04-22 15:29:32.935000+00:00", "files": [{"de