{"name": "r-tidyheatmap", "id": "62e70a54fa1be4757175bc3e", "package_types": ["conda"], "summary": "This is a tidy implementation for heatmap.  At the moment it is based on the (great) package 'ComplexHeatmap'.  The goal of this package is to interface a tidy data frame with this powerful tool.  Some of the advantages are: Row and/or columns colour annotations are easy to integrate just specifying one parameter (column names).  Custom grouping of rows is easy to specify providing a grouped tbl. For example: df %>% group_by(...).  Labels size adjusted by row and column total number.  Default use of Brewer and Viridis palettes.", "description": "", "home": "https://www.r-project.org, https://github.com/stemangiola/tidyHeatmap", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-tidyheatmap", "url": "http://api.anaconda.org/packages/bioconda/r-tidyheatmap", "html_url": "http://anaconda.org/bioconda/r-tidyheatmap", "versions": ["1.8.1", "1.11.4", "1.11.6", "1.12.2", "1.13.1"], "latest_version": "1.13.1", "platforms": {"noarch": "1.13.1"}, "conda_platforms": ["noarch"], "revision": 15, "license": "GPL-3.0-only", "license_url": null, "dev_url": "https://github.com/stemangiola/tidyHeatmap", "doc_url": "https://stemangiola.github.io/tidyHeatmap/articles/introduction.html", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42h3121a25_1", "r44h3121a25_3", "r44h3121a25_0", "r41h3121a25_0", "r43h3121a25_2"], "ndownloads": 3379, "releases": [{"version": "1.8.1", "distributions": [], "full_name": "bioconda/r-tidyheatmap/1.8.1"}, {"version": "1.11.4", "distributions": [], "full_name": "bioconda/r-tidyheatmap/1.11.4"