{"name": "bioconductor-nxtirfdata", "id": "6186fa86bfb835454bc24959", "package_types": ["conda"], "summary": "Data for NxtIRF", "description": "NxtIRFdata is a companion package for SpliceWiz, an interactive analysis and visualization tool for alternative splicing quantitation (including intron retention) for RNA-seq BAM files. NxtIRFdata contains Mappability files required for the generation of human and mouse references. NxtIRFdata also contains a synthetic genome reference and example BAM files used to demonstrate SpliceWiz's functionality. BAM files are based on 6 samples from the Leucegene dataset provided by NCBI Gene Expression Omnibus under accession number GSE67039.", "home": "https://bioconductor.org/packages/3.14/data/experiment/html/NxtIRFdata.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-nxtirfdata", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-nxtirfdata", "html_url": "http://anaconda.org/bioconda/bioconductor-nxtirfdata", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0", "r41hdfd78af_1"], "ndownloads": 8277, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-nxtirfdata/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-nxtirfdata/1.4.0"}, {"version": "1.