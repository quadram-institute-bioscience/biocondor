{"name": "gopeaks", "id": "6277fbe839552dcb5926ee6c", "package_types": ["conda"], "summary": "Peak caller for CUT&TAG data", "description": "GoPeaks is a peak caller designed for CUT&TAG/CUT&RUN sequencing data. GoPeaks by default works best with narrow peaks such as H3K4me3 and transcription factors. However, broad epigenetic marks like H3K27Ac/H3K4me1 require different the step, slide, and minwidth parameters. We encourage users to explore the parameters of GoPeaks to analyze their data.", "home": "https://github.com/maxsonBraunLab/gopeaks", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/gopeaks", "url": "http://api.anaconda.org/packages/bioconda/gopeaks", "html_url": "http://anaconda.org/bioconda/gopeaks", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"linux-64": "1.0.0", "osx-64": "1.0.0"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 4, "license": "MIT", "license_url": null, "dev_url": "https://github.com/maxsonBraunLab/gopeaks", "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h1fb5602_3", "hdb3de29_2", "h5a62fbc_0", "hf05dbd8_0", "h0dddbc0_1", "heaae5f8_2", "hf05dbd8_1", "h047eeb3_3"], "ndownloads": 3493, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/gopeaks/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2022-05-08 17:20:40.771000+00:00", "modified_at": "2025-04-22 15:29:32.546000+00:00", "files": [{"description": null, "dependencies": {"depends": [{"name": "libgcc-ng", "specs": [[">=", "10.3.0"]]}]}, "distribution_type": "conda", "basename": "linux-64/gopeaks-1.0.0-hf05dbd8_0.tar.bz2", "attrs": {"build_number