{"name": "bioconductor-simpleseg", "id": "63672bb0493a4c89d459730a", "package_types": ["conda"], "summary": "A package to perform simple cell segmentation", "description": "Image segmentation is the process of identifying the borders of individual objects (in this case cells) within an image. This allows for the features of cells such as marker expression and morphology to be extracted, stored and analysed. simpleSeg provides functionality for user friendly, watershed based segmentation on multiplexed cellular images in R based on the intensity of user specified protein marker channels. simpleSeg can also be used for the normalization of single cell data obtained from multiple images.", "home": "https://bioconductor.org/packages/3.16/bioc/html/simpleSeg.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-simpleseg", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-simpleseg", "html_url": "http://anaconda.org/bioconda/bioconductor-simpleseg", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 4127, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-simpleseg/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-simpleseg/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-simp