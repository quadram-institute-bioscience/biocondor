{"name": "bioconductor-segmenter", "id": "6188b295061d72975e5fd6da", "package_types": ["conda"], "summary": "Perform Chromatin Segmentation Analysis in R by Calling ChromHMM", "description": "Chromatin segmentation analysis transforms ChIP-seq data into signals over the genome. The latter represents the observed states in a multivariate Markov model to predict the chromatin's underlying states. ChromHMM, written in Java, integrates histone modification datasets to learn the chromatin states de-novo. The goal of this package is to call chromHMM from within R, capture the output files in an S4 object and interface to other relevant Bioconductor analysis tools. In addition, segmenter provides functions to test, select and visualize the output of the segmentation.", "home": "https://bioconductor.org/packages/3.14/bioc/html/segmenter.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-segmenter", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-segmenter", "html_url": "http://anaconda.org/bioconda/bioconductor-segmenter", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 6511, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-segmenter/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/biocond