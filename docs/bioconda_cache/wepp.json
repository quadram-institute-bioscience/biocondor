{"name": "wepp", "id": "691d0b2062e8625d983a46a9", "package_types": ["conda"], "summary": "Wastewater-Based Epidemiology using Phylogenetic Placements", "description": "WEPP (Wastewater-Based Epidemiology using Phylogenetic Placements) is a pathogen-agnostic pipeline that enhances wastewater surveillance by leveraging the pathogen's full phylogeny. It reports haplotype and lineage abundances, maps reads parsimoniously to selected haplotypes, and flags Unaccounted Alleles \u2014 those observed in the sample but unexplained by selected haplotypes, potentially indicating novel variants.\nWEPP performs parsimonious read placement on the mutation-annotated tree (MAT) to select a subset of haplotypes and adds their neighbors to form an initial candidate pool, which is passed to a deconvolution algorithm to estimate their relative abundances. An interactive dashboard enables visualization of haplotypes in the global phylogenetic tree and read-level analysis.", "home": "https://github.com/TurakhiaLab/WEPP", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/wepp", "url": "http://api.anaconda.org/packages/bioconda/wepp", "html_url": "http://anaconda.org/bioconda/wepp", "versions": ["0.1.4.1", "0.1.5", "0.1.5.1", "0.1.5.2"], "latest_version": "0.1.5.2", "platforms": {"linux-64": "0.1.5.2", "osx-64": "0.1.5.2"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 24, "license": "MIT", "license_url": null, "dev_url": null, "doc_url": "https://turakhia.ucsd.edu/WEPP", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h9f2696a_0", "h02b269f_0", "h8c6bde3_0", "hf1fc63c_0", "hfa52d19_0", "h17ac2a2_0", "h3cc91ff_0", "