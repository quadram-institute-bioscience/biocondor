{"name": "r-locuszoomr", "id": "6739016f8690915c0cb614f2", "package_types": ["conda"], "summary": "Publication-ready regional gene locus plots similar to those produced by the web interface 'LocusZoom' <https://my.locuszoom.org>, but running locally in R. Genetic or genomic data with gene annotation tracks are plotted via R base graphics, 'ggplot2' or 'plotly', allowing flexibility and easy customisation including laying out multiple locus plots on the same page. It uses the 'LDlink' API <https://ldlink.nih.gov/?tab=apiaccess> to query linkage disequilibrium data from the 1000 Genomes Project and can overlay this on plots.", "description": "", "home": "https://github.com/myles-lewis/locuszoomr", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-locuszoomr", "url": "http://api.anaconda.org/packages/bioconda/r-locuszoomr", "html_url": "http://anaconda.org/bioconda/r-locuszoomr", "versions": ["0.3.5", "0.3.6", "0.3.7", "0.3.8"], "latest_version": "0.3.8", "platforms": {"noarch": "0.3.8"}, "conda_platforms": ["noarch"], "revision": 13, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43h3121a25_0", "r44h3121a25_1", "r44h3121a25_0"], "ndownloads": 1077, "releases": [{"version": "0.3.5", "distributions": [], "full_name": "bioconda/r-locuszoomr/0.3.5"}, {"version": "0.3.6", "distributions": [], "full_name": "bioconda/r-locuszoomr/0.3.6"}, {"version": "0.3.7", "distributions": [], "full_name": "bioconda/r-locuszoomr/0.3.7"}, {"version": "0.3.8", "distributions": [], "full_name": "bioconda/r-locuszoomr/0.3.8"}], "watchers": 1, "upvote