{"name": "ionquant", "id": "65d8c74ec19c9a91794bd736", "package_types": ["conda"], "summary": "A label free quantification tool", "description": "IonQuant is a fast and comprehensive tool for MS1 precursor intensity-based quantification for timsTOF PASEF DDA and non-timsTOF (e.g., Orbitrap) data.\nIt enables label-free quantification with false discovery (FDR) controlled match-between-runs (MBR).\nIt can also be used for quantification in labelling-based experiments such as those involving SILAC, dimethyl, or similar labelling strategies.\n\nIonQuant is available freely for academic research and educational purposes only, in accordance with the terms at https://msfragger.arsci.com/upgrader/LICENSE-ACADEMIC.pdf.\n", "home": "https://github.com/Nesvilab/IonQuant", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/ionquant", "url": "http://api.anaconda.org/packages/bioconda/ionquant", "html_url": "http://anaconda.org/bioconda/ionquant", "versions": ["1.10.12", "1.10.27", "1.11.9"], "latest_version": "1.11.9", "platforms": {"noarch": "1.11.9"}, "conda_platforms": ["noarch"], "revision": 10, "license": "Academic License", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["py311hdfd78af_0", "py312hdfd78af_1", "py312hdfd78af_0", "py313hdfd78af_0"], "ndownloads": 1913, "releases": [{"version": "1.10.12", "distributions": [], "full_name": "bioconda/ionquant/1.10.12"}, {"version": "1.10.27", "distributions": [], "full_name": "bioconda/ionquant/1.10.27"}, {"version": "1.11.9", "distributions": [], "full_name": "bioconda/ionquant/1.11.9"}], "watchers": 1, "upvot