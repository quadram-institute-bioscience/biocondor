{"name": "plinder", "id": "68379b153c7e623a79279ffd", "package_types": ["conda"], "summary": "PLINDER: The Protein-Ligand INteraction Dataset and Evaluation Resource.", "description": "Protein-ligand interactions are foundational to the understanding of science and discovery of therapies.\nHowever, to this date, no large, high quality datasets with real-life relevant evaluations exist.\n\nPLINDER is an academic-industry collaboration to address this, driven by VantAI, NVIDIA, the Computational Structural Biology group at the University of Basel & SIB Swiss Institute of Bioinformatics - co-organizers of CASP, and MIT.\nWe aim to provide a gold standard dataset and evaluations to push the field of computational protein-ligand interactions prediction forward.\n", "home": "https://www.plinder.sh", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/plinder", "url": "http://api.anaconda.org/packages/bioconda/plinder", "html_url": "http://anaconda.org/bioconda/plinder", "versions": ["0.2.25"], "latest_version": "0.2.25", "platforms": {"noarch": "0.2.25"}, "conda_platforms": ["noarch"], "revision": 6, "license": "MIT AND Apache-2.0", "license_url": null, "dev_url": "https://github.com/plinder-org/plinder", "doc_url": "https://plinder-org.github.io/plinder", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0", "pyhdfd78af_1", "pyhdfd78af_2", "pyhdfd78af_3"], "ndownloads": 490, "releases": [{"version": "0.2.25", "distributions": [], "full_name": "bioconda/plinder/0.2.25"}], "watchers": 1, "upvoted": 0, "created_at": "2025-05-28 23:24:05.434000+00:00", "modified_at": "2025-06-18 03:08:33.312000+00:00", 