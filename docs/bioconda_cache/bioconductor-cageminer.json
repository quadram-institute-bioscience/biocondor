{"name": "bioconductor-cageminer", "id": "618b1ec48d5f5893646f7b81", "package_types": ["conda"], "summary": "Candidate Gene Miner", "description": "This package aims to integrate GWAS-derived SNPs and coexpression networks to mine candidate genes associated with a particular phenotype. For that, users must define a set of guide genes, which are known genes involved in the studied phenotype. Additionally, the mined candidates can be given a score that favor candidates that are hubs and/or transcription factors. The scores can then be used to rank and select the top n most promising genes for downstream experiments.", "home": "https://bioconductor.org/packages/3.14/bioc/html/cageminer.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cageminer", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cageminer", "html_url": "http://anaconda.org/bioconda/bioconductor-cageminer", "versions": ["1.0.0", "1.4.0", "1.6.1", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0", "r41hdfd78af_0"], "ndownloads": 7483, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-cageminer/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-cageminer/1.4.0"}, {"version": "1.6.1", "distributions": [], "full_name": "bioconda/bioconductor-cageminer/1.6.1"}, {"version": "1.8.0", "distr