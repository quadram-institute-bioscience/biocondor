{"name": "telogator2", "id": "6920205a1ee8f643dbd93880", "package_types": ["conda"], "summary": "Analyze allele-specific telomere length from PacBio and Nanopore reads", "description": "Telogator2 is a bioinformatics tool for analyzing telomeres from long-read sequencing data.\nIt measures allele-specific telomere length and characterizes telomere variant repeat (TVR)\nsequences from PacBio HiFi and Oxford Nanopore sequencing platforms. The tool supports\nhuman and non-human reference genomes and provides detailed output including TSV results\nand visualization plots.\n", "home": "https://github.com/zstephens/telogator2", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/telogator2", "url": "http://api.anaconda.org/packages/bioconda/telogator2", "html_url": "http://anaconda.org/bioconda/telogator2", "versions": ["2.2.2", "2.2.3"], "latest_version": "2.2.3", "platforms": {"noarch": "2.2.3"}, "conda_platforms": ["noarch"], "revision": 6, "license": "MIT", "license_url": null, "dev_url": "https://github.com/zstephens/telogator2", "doc_url": "https://github.com/zstephens/telogator2/blob/main/README.md", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 152, "releases": [{"version": "2.2.2", "distributions": [], "full_name": "bioconda/telogator2/2.2.2"}, {"version": "2.2.3", "distributions": [], "full_name": "bioconda/telogator2/2.2.3"}], "watchers": 1, "upvoted": 0, "created_at": "2025-11-21 08:18:34.732000+00:00", "modified_at": "2025-12-02 20:34:58.513000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/tel