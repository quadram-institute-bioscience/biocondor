{"name": "pia", "id": "64f2a1f99f1b7acd7f3802b1", "package_types": ["conda"], "summary": "PIA is a toolbox for MS based protein inference and identification analysis.", "description": "PIA allows you to inspect the results of common proteomics spectrum identification\nsearch engines, combine them seamlessly and conduct statistical analyses. The main\nfocus of PIA lays on the integrated inference algorithms, i.e. concluding the proteins\nfrom a set of identified spectra. But it also allows you to inspect your peptide\nspectrum matches, calculate FDR values across different search engine results and\nvisualize the correspondence between PSMs, peptides and proteins.\n", "home": "https://github.com/medbioinf/pia", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/pia", "url": "http://api.anaconda.org/packages/bioconda/pia", "html_url": "http://anaconda.org/bioconda/pia", "versions": ["1.4.8", "1.4.9", "1.4.10", "1.5.0", "1.5.1", "1.5.2", "1.5.3", "1.5.4", "1.5.5", "1.5.6", "1.5.7"], "latest_version": "1.5.7", "platforms": {"noarch": "1.5.7"}, "conda_platforms": ["noarch"], "revision": 30, "license": "BSD-3-Clause", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["hdfd78af_2", "hdfd78af_1", "hdfd78af_0"], "ndownloads": 9429, "releases": [{"version": "1.4.8", "distributions": [], "full_name": "bioconda/pia/1.4.8"}, {"version": "1.4.9", "distributions": [], "full_name": "bioconda/pia/1.4.9"}, {"version": "1.4.10", "distributions": [], "full_name": "bioconda/pia/1.4.10"}, {"version": "1.5.0", "distributions": [], "full_name": "bioconda/pia/1.5.0"}, {"versi