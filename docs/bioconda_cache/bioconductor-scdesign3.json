{"name": "bioconductor-scdesign3", "id": "657cc168ab32cf73da9012e9", "package_types": ["conda"], "summary": "A unified framework of realistic in silico data generation and statistical model inference for single-cell and spatial omics", "description": "We present a statistical simulator, scDesign3, to generate realistic single-cell and spatial omics data, including various cell states, experimental designs, and feature modalities, by learning interpretable parameters from real data. Using a unified probabilistic model for single-cell and spatial omics data, scDesign3 infers biologically meaningful parameters; assesses the goodness-of-fit of inferred cell clusters, trajectories, and spatial locations; and generates in silico negative and positive controls for benchmarking computational tools.", "home": "https://bioconductor.org/packages/3.18/bioc/html/scDesign3.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-scdesign3", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-scdesign3", "html_url": "http://anaconda.org/bioconda/bioconductor-scdesign3", "versions": ["1.0.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 1694, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-scdesign3/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-scdesign3/1.4.0