{"name": "bioconductor-svanumt", "id": "618b78429501cf2a1ddc538a", "package_types": ["conda"], "summary": "NUMT detection from structural variant calls", "description": "svaNUMT contains functions for detecting NUMT events from structural variant calls. It takes structural variant calls in GRanges of breakend notation and identifies NUMTs by nuclear-mitochondrial breakend junctions. The main function reports candidate NUMTs if there is a pair of valid insertion sites found on the nuclear genome within a certain distance threshold. The candidate NUMTs are reported by events.", "home": "https://bioconductor.org/packages/3.14/bioc/html/svaNUMT.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-svanumt", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-svanumt", "html_url": "http://anaconda.org/bioconda/bioconductor-svanumt", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "GPL-3 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r44hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 7290, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-svanumt/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-svanumt/1.4.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-svanumt/1.6.0"}, {"version": "1.8.0", "distributions": [], "full_name": "bioconda/bi