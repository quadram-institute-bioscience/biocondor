{"name": "bioconductor-epiregulon", "id": "6775769c46be6f6ddb52a590", "package_types": ["conda"], "summary": "Gene regulatory network inference from single cell epigenomic data", "description": "Gene regulatory networks model the underlying gene regulation hierarchies that drive gene expression and observed phenotypes. Epiregulon infers TF activity in single cells by constructing a gene regulatory network (regulons). This is achieved through integration of scATAC-seq and scRNA-seq data and incorporation of public bulk TF ChIP-seq data. Links between regulatory elements and their target genes are established by computing correlations between chromatin accessibility and gene expressions.", "home": "https://bioconductor.org/packages/3.20/bioc/html/epiregulon.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-epiregulon", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-epiregulon", "html_url": "http://anaconda.org/bioconda/bioconductor-epiregulon", "versions": ["1.2.0"], "latest_version": "1.2.0", "platforms": {"linux-64": "1.2.0"}, "conda_platforms": ["linux-64"], "revision": 3, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44he5774e6_0"], "ndownloads": 490, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-epiregulon/1.2.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-01-01 17:08:44.545000+00:00", "modified_at": "2025-04-22 15:29:44.209000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "cond