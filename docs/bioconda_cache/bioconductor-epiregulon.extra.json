{"name": "bioconductor-epiregulon.extra", "id": "677a023c4af83b537d45fe1f", "package_types": ["conda"], "summary": "Companion package to epiregulon with additional plotting, differential and graph functions", "description": "Gene regulatory networks model the underlying gene regulation hierarchies that drive gene expression and observed phenotypes. Epiregulon infers TF activity in single cells by constructing a gene regulatory network (regulons). This is achieved through integration of scATAC-seq and scRNA-seq data and incorporation of public bulk TF ChIP-seq data. Links between regulatory elements and their target genes are established by computing correlations between chromatin accessibility and gene expressions.", "home": "https://bioconductor.org/packages/3.20/bioc/html/epiregulon.extra.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-epiregulon.extra", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-epiregulon.extra", "html_url": "http://anaconda.org/bioconda/bioconductor-epiregulon.extra", "versions": ["1.2.0"], "latest_version": "1.2.0", "platforms": {"noarch": "1.2.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 440, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-epiregulon.extra/1.2.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-01-05 03:53:32.403000+00:00", "modified_at": "2025-04-22 15:29:44.333000+00:00", "files": [{"description": null,