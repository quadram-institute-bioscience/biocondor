{"name": "bioconductor-netomics", "id": "6186750303b93eb2b194782c", "package_types": ["conda"], "summary": "Multi-Omics (time-course) network-based integration and interpretation", "description": "netOmics is a multi-omics networks builder and explorer. It uses a combination of network inference algorithms and and knowledge-based graphs to build multi-layered networks. The package can be combined with timeOmics to incorporate time-course expression data and build sub-networks from multi-omics kinetic clusters. Finally, from the generated multi-omics networks, propagation analyses allow the identification of missing biological functions (1), multi-omics mechanisms (2) and molecules between kinetic clusters (3). This helps to resolve complex regulatory mechanisms.", "home": "https://bioconductor.org/packages/3.14/bioc/html/netOmics.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-netomics", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-netomics", "html_url": "http://anaconda.org/bioconda/bioconductor-netomics", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 8, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 7380, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-netomics/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-netomics/1.4.0"}, {"version