{"name": "bioconductor-spatzie", "id": "618b796c414b5ba20efec565", "package_types": ["conda"], "summary": "Identification of enriched motif pairs from chromatin interaction data", "description": "Identifies motifs that are significantly co-enriched from enhancer-promoter interaction data. While enhancer-promoter annotation is commonly used to define groups of interaction anchors, spatzie also supports co-enrichment analysis between preprocessed interaction anchors.  Supports BEDPE interaction data derived from genome-wide assays such as HiC, ChIA-PET, and HiChIP. Can also be used to look for differentially enriched motif pairs between two interaction experiments.", "home": "https://bioconductor.org/packages/3.14/bioc/html/spatzie.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-spatzie", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-spatzie", "html_url": "http://anaconda.org/bioconda/bioconductor-spatzie", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r44hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 7167, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-spatzie/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-spatzie/1.4.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-spatzie/