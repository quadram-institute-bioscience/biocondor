{"name": "bioconductor-microstasis", "id": "64b3ecdae5243e3d3dd73f6b", "package_types": ["conda"], "summary": "Microbiota STability ASsessment via Iterative cluStering", "description": "The toolkit '\u00b5STASIS', or microSTASIS, has been developed for the stability analysis of microbiota in a temporal framework by leveraging on iterative clustering. Concretely, the core function uses Hartigan-Wong k-means algorithm as many times as possible for stressing out paired samples from the same individuals to test if they remain together for multiple numbers of clusters over a whole data set of individuals. Moreover, the package includes multiple functions to subset samples from paired times, validate the results or visualize the output.", "home": "https://bioconductor.org/packages/3.17/bioc/html/microSTASIS.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-microstasis", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-microstasis", "html_url": "http://anaconda.org/bioconda/bioconductor-microstasis", "versions": ["1.0.0", "1.2.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 7, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 3075, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-microstasis/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-microstasis/1.2.0"}, {"version": "1.6.0", "distributions": [], "full_n