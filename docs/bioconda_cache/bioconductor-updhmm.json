{"name": "bioconductor-updhmm", "id": "6904b64f270bbcad3f717863", "package_types": ["conda"], "summary": "Detecting Uniparental Disomy through NGS trio data", "description": "Uniparental disomy (UPD) is a genetic condition where an individual inherits both copies of a chromosome or part of it from one parent, rather than one copy from each parent. This package contains a HMM for detecting UPDs through HTS (High Throughput Sequencing) data from trio assays. By analyzing the genotypes in the trio, the model infers a hidden state (normal, father isodisomy, mother isodisomy, father heterodisomy and mother heterodisomy).", "home": "https://bioconductor.org/packages/3.22/bioc/html/UPDhmm.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-updhmm", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-updhmm", "html_url": "http://anaconda.org/bioconda/bioconductor-updhmm", "versions": ["1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 47, "releases": [{"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-updhmm/1.6.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-10-31 13:14:55.557000+00:00", "modified_at": "2025-10-31 13:14:56.851000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/bioconductor-updhmm-1.6.0-r44hdfd78af_0.conda", "attrs": {"operatingsyst