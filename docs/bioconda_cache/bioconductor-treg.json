{"name": "bioconductor-treg", "id": "63670e94bdd024375c7d804a", "package_types": ["conda"], "summary": "Tools for finding Total RNA Expression Genes in single nucleus RNA-seq data", "description": "RNA abundance and cell size parameters could improve RNA-seq deconvolution algorithms to more accurately estimate cell type proportions given the different cell type transcription activity levels. A Total RNA Expression Gene (TREG) can facilitate estimating total RNA content using single molecule fluorescent in situ hybridization (smFISH). We developed a data-driven approach using a measure of expression invariance to find candidate TREGs in postmortem human brain single nucleus RNA-seq. This R package implements the method for identifying candidate TREGs from snRNA-seq data.", "home": "https://bioconductor.org/packages/3.16/bioc/html/TREG.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-treg", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-treg", "html_url": "http://anaconda.org/bioconda/bioconductor-treg", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 5158, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-treg/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-treg/1.4.0"}, {"version": "1.