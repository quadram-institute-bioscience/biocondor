{"name": "bioconductor-basicstan", "id": "6367bfc91f9cf5f92a9bc562", "package_types": ["conda"], "summary": "Stan implementation of BASiCS", "description": "Provides an interface to infer the parameters of BASiCS using the variational inference (ADVI), Markov chain Monte Carlo (NUTS), and maximum a posteriori (BFGS) inference engines in the Stan programming language. BASiCS is a Bayesian hierarchical model that uses an adaptive Metropolis within Gibbs sampling scheme. Alternative inference methods provided by Stan may be preferable in some situations, for example for particularly large data or posterior distributions with difficult geometries.", "home": "https://bioconductor.org/packages/3.16/bioc/html/BASiCStan.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-basicstan", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-basicstan", "html_url": "http://anaconda.org/bioconda/bioconductor-basicstan", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"linux-64": "1.8.0", "osx-64": "1.8.0"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 10, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44he5774e6_0", "r42hf17093f_1", "r43hc0ef7c4_0", "r42hb890f52_0", "r43hf17093f_0", "r42hc247a5b_0", "r44h35d7169_0", "r42hc0ef7c4_1"], "ndownloads": 5738, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-basicstan/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-basicstan/1.2.0"}, {"ver