{"name": "bioconductor-vdjdive", "id": "636710ebcecfaf2e85742297", "package_types": ["conda"], "summary": "Analysis Tools for 10X V(D)J Data", "description": "This package provides functions for handling and analyzing immune receptor repertoire data, such as produced by the CellRanger V(D)J pipeline. This includes reading the data into R, merging it with paired single-cell data, quantifying clonotype abundances, calculating diversity metrics, and producing common plots. It implements the E-M Algorithm for clonotype assignment, along with other methods, which makes use of ambiguous cells for improved quantification.", "home": "https://bioconductor.org/packages/3.16/bioc/html/VDJdive.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-vdjdive", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-vdjdive", "html_url": "http://anaconda.org/bioconda/bioconductor-vdjdive", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.2.0", "osx-64": "1.8.0", "linux-64": "1.8.0"}, "conda_platforms": ["linux-64", "osx-64", "noarch"], "revision": 10, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r43hc0ef7c4_0", "r44h35d7169_0", "r43hf17093f_0", "r44he5774e6_0"], "ndownloads": 4320, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-vdjdive/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-vdjdive/1.2.0"}, {"version": "1.4.0", "distributions": [], "f