{"name": "bioconductor-raresim", "id": "6363b864d4690f717735869e", "package_types": ["conda"], "summary": "Simulation of Rare Variant Genetic Data", "description": "Haplotype simulations of rare variant genetic data that emulates real data can be performed with RAREsim. RAREsim uses the expected number of variants in MAC bins - either as provided by default parameters or estimated from target data - and an abundance of rare variants as simulated HAPGEN2 to probabilistically prune variants. RAREsim produces haplotypes that emulate real sequencing data with respect to the total number of variants, allele frequency spectrum, haplotype structure, and variant annotation.", "home": "https://bioconductor.org/packages/3.16/bioc/html/RAREsim.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-raresim", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-raresim", "html_url": "http://anaconda.org/bioconda/bioconductor-raresim", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0", "1.14.0"], "latest_version": "1.14.0", "platforms": {"noarch": "1.14.0"}, "conda_platforms": ["noarch"], "revision": 12, "license": "GPL-3.0-only", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0", "r45hdfd78af_0"], "ndownloads": 5277, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-raresim/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-raresim/1.4.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconduct