{"name": "r-flanders", "id": "685210843cb16415336cde69", "package_types": ["conda"], "summary": "Fast colocalization using AnnData objects in R", "description": "flanders is an R package designed to seamlessly convert finemapping output files from the nf-flanders pipeline\ninto a unified AnnData object and facilitate colocalization analysis.\nThe package provides functions to:\n- Convert multiple *finemap.rds files into a single AnnData object with credible set metadata.\n- Generate an input table (coloc_input) for colocalization testing.\n- Run pairwise colocalization tests, with minimal runtime overhead (typically 5\u201310 tests per second on standard hardware).\n", "home": "https://github.com/Biostatistics-Unit-HT/flanders_r", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-flanders", "url": "http://api.anaconda.org/packages/bioconda/r-flanders", "html_url": "http://anaconda.org/bioconda/r-flanders", "versions": ["1.0.0", "1.0.1"], "latest_version": "1.0.1", "platforms": {"noarch": "1.0.1"}, "conda_platforms": ["noarch"], "revision": 6, "license": "MIT", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 314, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/r-flanders/1.0.0"}, {"version": "1.0.1", "distributions": [], "full_name": "bioconda/r-flanders/1.0.1"}], "watchers": 1, "upvoted": 0, "created_at": "2025-06-18 01:04:04.060000+00:00", "modified_at": "2025-08-28 00:45:48.477000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "base