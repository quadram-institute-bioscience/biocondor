{"name": "bioconductor-cleanuprnaseq", "id": "67749b52c8690cff0b7a323f", "package_types": ["conda"], "summary": "Detect and Correct Genomic DNA Contamination in RNA-seq Data", "description": "RNA-seq data generated by some library preparation methods, such as rRNA-depletion-based method and the SMART-seq method, might be contaminated by genomic DNA (gDNA), if DNase I disgestion is not performed properly during RNA preparation. CleanUpRNAseq is developed to check if RNA-seq data is suffered from gDNA contamination. If so, it can perform correction for gDNA contamination and reduce false discovery rate of differentially expressed genes.", "home": "https://bioconductor.org/packages/3.20/bioc/html/CleanUpRNAseq.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cleanuprnaseq", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cleanuprnaseq", "html_url": "http://anaconda.org/bioconda/bioconductor-cleanuprnaseq", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"noarch": "1.0.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 191, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-cleanuprnaseq/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-01-01 01:33:06.176000+00:00", "modified_at": "2025-04-22 15:29:44.204000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/bioconductor-cleanuprnaseq-1.0