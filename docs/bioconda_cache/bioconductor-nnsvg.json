{"name": "bioconductor-nnsvg", "id": "636723a246f81babca67e92c", "package_types": ["conda"], "summary": "Scalable identification of spatially variable genes in spatially-resolved transcriptomics data", "description": "Method for scalable identification of spatially variable genes (SVGs) in spatially-resolved transcriptomics data. The method is based on nearest-neighbor Gaussian processes and uses the BRISC algorithm for model fitting and parameter estimation. Allows identification and ranking of SVGs with flexible length scales across a tissue slide or within spatial domains defined by covariates. Scales linearly with the number of spatial locations and can be applied to datasets containing thousands or more spatial locations.", "home": "https://bioconductor.org/packages/3.16/bioc/html/nnSVG.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-nnsvg", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-nnsvg", "html_url": "http://anaconda.org/bioconda/bioconductor-nnsvg", "versions": ["1.2.0", "1.4.1", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 4823, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-nnsvg/1.2.0"}, {"version": "1.4.1", "distributions": [], "full_name": "bioconda/bioconductor-nnsvg/1.4.1"}, {"version": "1.6.0", "distributions": [], "full