{"name": "bioconductor-tanggle", "id": "61815958c16f55df02a480e5", "package_types": ["conda"], "summary": "Visualization of Phylogenetic Networks", "description": "Offers functions for plotting split (or implicit) networks (unrooted, undirected) and explicit networks (rooted, directed) with reticulations extending. 'ggtree' and using functions from 'ape' and 'phangorn'. It extends the 'ggtree' package [@Yu2017] to allow the visualization of phylogenetic networks using the 'ggplot2' syntax. It offers an alternative to the plot functions already available in 'ape' Paradis and Schliep (2019) <doi:10.1093/bioinformatics/bty633> and 'phangorn' Schliep (2011) <doi:10.1093/bioinformatics/btq706>.", "home": "https://bioconductor.org/packages/3.14/bioc/html/tanggle.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-tanggle", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-tanggle", "html_url": "http://anaconda.org/bioconda/bioconductor-tanggle", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r41hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 7929, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-tanggle/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-tanggle/1.4.0"}, {"version": "1.6.0", "distributions": [], "full_name