{"name": "gothresher", "id": "62b046d1e8e8f33544d1ef83", "package_types": ["conda"], "summary": "GOThresher: a program to remove annotation biases from protein function annotation datasets", "description": "GOThresher removes annotation bias from GAF files based on GO term information content, GO evidence, annotation source, number of proteins annotated from a given source, and date. GOThresher accepts one or more GAF files as input. The motivation for GOThresher lies in the observation that protein function annotations are biased due to high throughput experimental studies. Removing such annotation biases can help present a more balanced picture of protein annotations for a given organism or set of proteins.", "home": "https://github.com/FriedbergLab/GOThresher", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/gothresher", "url": "http://api.anaconda.org/packages/bioconda/gothresher", "html_url": "http://anaconda.org/bioconda/gothresher", "versions": ["1.0.21", "1.0.24", "1.0.26", "1.0.27", "1.0.28", "1.0.29"], "latest_version": "1.0.29", "platforms": {"noarch": "1.0.29"}, "conda_platforms": ["noarch"], "revision": 12, "license": "GPL-3.0-only", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyh7cba7a3_0", "pyh5e36f6f_0"], "ndownloads": 12903, "releases": [{"version": "1.0.21", "distributions": [], "full_name": "bioconda/gothresher/1.0.21"}, {"version": "1.0.24", "distributions": [], "full_name": "bioconda/gothresher/1.0.24"}, {"version": "1.0.26", "distributions": [], "full_name": "bioconda/gothresher/1.0.26"}, {"version": "1.0.27", "distribu