{"name": "bioconductor-clustirr", "id": "656d0009d11443e32f42b7dd", "package_types": ["conda"], "summary": "Clustering of immune receptor repertoires", "description": "ClustIRR analyzes repertoires of B- and T-cell receptors. It starts by identifying communities of immune receptors with similar specificities, based on the sequences of their complementarity-determining regions (CDRs). Next, it employs a Bayesian probabilistic models to quantify differential community occupancy (DCO) between repertoires, allowing the identification of expanding or contracting communities in response to e.g. infection or cancer treatment.", "home": "https://bioconductor.org/packages/3.18/bioc/html/ClustIRR.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-clustirr", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-clustirr", "html_url": "http://anaconda.org/bioconda/bioconductor-clustirr", "versions": ["1.0.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.0.0", "linux-64": "1.8.0", "osx-64": "1.8.0"}, "conda_platforms": ["osx-64", "noarch", "linux-64"], "revision": 10, "license": "GPL-3 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44h35d7169_0", "r45ha27e39d_0", "r43hdfd78af_0", "r44he5774e6_0", "r45hfbc58e1_0"], "ndownloads": 1324, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-clustirr/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-clustirr/1.4.0"}, {"version": "1.8.0", "distributions": [], "full_name