{"name": "bioconductor-epistack", "id": "6182a9520a76b26c1c90b03f", "package_types": ["conda"], "summary": "Heatmaps of Stack Profiles from Epigenetic Signals", "description": "The epistack package main objective is the visualizations of stacks of genomic tracks (such as, but not restricted to, ChIP-seq, ATAC-seq, DNA methyation or genomic conservation data) centered at genomic regions of interest. epistack needs three different inputs: 1) a genomic score objects, such as ChIP-seq coverage or DNA methylation values, provided as a `GRanges` (easily obtained from `bigwig` or `bam` files). 2) a list of feature of interest, such as peaks or transcription start sites, provided as a `GRanges` (easily obtained from `gtf` or `bed` files). 3) a score to sort the features, such as peak height or gene expression value.", "home": "https://bioconductor.org/packages/3.14/bioc/html/epistack.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-epistack", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-epistack", "html_url": "http://anaconda.org/bioconda/bioconductor-epistack", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r41hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 7983, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-epistack/1.0.0"}, {"version": "1.