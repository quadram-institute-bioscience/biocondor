{"name": "djinn", "id": "68d3009bf3c04e8cd05a897b", "package_types": ["conda"], "summary": "Convert your linked-read data between formats, almost like magic.", "description": "There are disagreements between formats for linked-read data. Haplotagging thinks\nlinked-read barcodes and FASTQ files should look one way, stLFR a different way, and\nTELLseq yet another. Djinn lets you convert to a standard format, convert between these\nFASTQ formats, barcode styles, etc. It also provides a convenient method to upload linked-read\ndata to NCBI that preserves barcode information.\n", "home": "https://github.com/pdimens/djinn", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/djinn", "url": "http://api.anaconda.org/packages/bioconda/djinn", "html_url": "http://anaconda.org/bioconda/djinn", "versions": ["1.0", "1.0.1", "1.1", "2.0", "2.1"], "latest_version": "2.1", "platforms": {"noarch": "2.1"}, "conda_platforms": ["noarch"], "revision": 15, "license": "GPL-3.0-or-later", "license_url": null, "dev_url": "https://github.com/pdimens/djinn", "doc_url": "https://pdimens.github.io/djinn", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 243, "releases": [{"version": "1.0", "distributions": [], "full_name": "bioconda/djinn/1.0"}, {"version": "1.0.1", "distributions": [], "full_name": "bioconda/djinn/1.0.1"}, {"version": "1.1", "distributions": [], "full_name": "bioconda/djinn/1.1"}, {"version": "2.0", "distributions": [], "full_name": "bioconda/djinn/2.0"}, {"version": "2.1", "distributions": [], "full_name": "bioconda/djinn/2.1"}], "watchers": 1, "upvoted": 0, "created_at": "2025-09-23