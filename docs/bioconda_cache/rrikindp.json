{"name": "rrikindp", "id": "65d4cd88afe9570abfbbbf55", "package_types": ["conda"], "summary": "Evaluation of thermodynamic and kinetic features of RNA-RNA interactions.", "description": "RRIkinDP evaluated thermodynamic and kinetic features of RNA-RNA interactions. As input, two RNA\nsequences as well as their interaction structure is provided. The tool generates the state space of\nall intermediate interactions from single base pair interactions to the full input interaction.\nOn top of this state space it computes the barrier energy for the best direct path from a given\nstart interaction to the full input interaction.\n", "home": "https://github.com/mwaldl/RRIkinDP", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/rrikindp", "url": "http://api.anaconda.org/packages/bioconda/rrikindp", "html_url": "http://anaconda.org/bioconda/rrikindp", "versions": ["0.0.1", "0.0.2"], "latest_version": "0.0.2", "platforms": {"linux-64": "0.0.2", "osx-64": "0.0.2"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 21, "license": "GPL-3.0-only", "license_url": null, "dev_url": "https://github.com/mwaldl/RRIkinDP", "doc_url": "https://doi.org/10.1101/2023.07.28.548983", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["py311h2a4ad6c_1", "py38h2123bcc_1", "py39h7356f67_0", "py38h820c706_0", "py312h28adbb1_1", "py310h84f13bb_1", "py38h71dc5ba_0", "py310h5b5d71c_0", "py39h9e0f934_1", "py39h68928f9_0", "py310h96bb6a0_0"], "ndownloads": 3662, "releases": [{"version": "0.0.1", "distributions": [], "full_name": "bioconda/rrikindp/0.0.1"}, {"version": "0.0.2", "distributions": [], "full_name": "bioconda/rrikindp/0.0.2"}