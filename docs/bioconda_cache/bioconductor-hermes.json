{"name": "bioconductor-hermes", "id": "636c523b54e9ace854f27da5", "package_types": ["conda"], "summary": "Preprocessing, analyzing, and reporting of RNA-seq data", "description": "Provides classes and functions for quality control, filtering, normalization and differential expression analysis of pre-processed `RNA-seq` data. Data can be imported from `SummarizedExperiment` as well as `matrix` objects and can be annotated from `BioMart`. Filtering for genes without too low expression or containing required annotations, as well as filtering for samples with sufficient correlation to other samples or total number of reads is supported. The standard normalization methods including cpm, rpkm and tpm can be used, and 'DESeq2` as well as voom differential expression analyses are available.", "home": "https://bioconductor.org/packages/3.16/bioc/html/hermes.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-hermes", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-hermes", "html_url": "http://anaconda.org/bioconda/bioconductor-hermes", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "Apache License 2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 5155, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-hermes/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-