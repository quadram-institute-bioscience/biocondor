{"name": "bioconductor-heron", "id": "6577e2f3e7f382ddcce76599", "package_types": ["conda"], "summary": "Hierarchical Epitope pROtein biNding", "description": "HERON is a software package for analyzing peptide binding array data. In addition to identifying significant binding probes, HERON also provides functions for finding epitopes (string of consecutive peptides within a protein). HERON also calculates significance on the probe, epitope, and protein level by employing meta p-value methods.  HERON is designed for obtaining calls on the sample level and calculates fractions of hits for different conditions.", "home": "https://bioconductor.org/packages/3.18/bioc/html/HERON.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-heron", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-heron", "html_url": "http://anaconda.org/bioconda/bioconductor-heron", "versions": ["1.0.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "GPL (>= 3)", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 816, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-heron/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-heron/1.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-12 04:34:59.216000+00:00", "modified_at": "2025-04-22 15:29:39.706000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "c