{"name": "r-jetset", "id": "62b4665eaae6eba13a555469", "package_types": ["conda"], "summary": "On Affymetrix gene expression microarrays, a single gene may be measured by multiple probe sets. This can present a mild conundrum when attempting to evaluate a gene \"signature\" that is defined by gene names rather than by specific probe sets. This package provides a one-to-one mapping from gene to \"best\" probe set for four Affymetrix human gene expression microarrays: hgu95av2, hgu133a, hgu133plus2, and u133x3p. This package also includes the pre-calculated probe set quality scores that were used to define the mapping.", "description": "", "home": "http://www.cbs.dtu.dk/biotools/jetset/", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-jetset", "url": "http://api.anaconda.org/packages/bioconda/r-jetset", "html_url": "http://anaconda.org/bioconda/r-jetset", "versions": ["3.4.0"], "latest_version": "3.4.0", "platforms": {"noarch": "3.4.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42h3121a25_1", "r44h3121a25_3", "r43h3121a25_2", "r41h3121a25_0"], "ndownloads": 2625, "releases": [{"version": "3.4.0", "distributions": [], "full_name": "bioconda/r-jetset/3.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2022-06-23 13:10:54.119000+00:00", "modified_at": "2025-04-22 15:29:32.885000+00:00", "files": [{"description": null, "dependencies": {"depends": [{"name": "bioconductor-annotationdbi", "specs": []}, {"name": "bioconductor-org.hs.eg.db", "specs": []}, {"name": "r-base