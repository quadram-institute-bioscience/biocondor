{"name": "bioconductor-redisparam", "id": "636661c6d4690f717742cb54", "package_types": ["conda"], "summary": "Provide a 'redis' back-end for BiocParallel", "description": "This package provides a Redis-based back-end for BiocParallel, enabling an alternative mechanism for distributed computation. The The 'manager' distributes tasks to a 'worker' pool through a central Redis server, rather than directly to workers as with other BiocParallel implementations. This means that the worker pool can change dynamically during job evaluation. All features of BiocParallel are supported, including reproducible random number streams, logging to the manager, and alternative 'load balancing' task distributions.", "home": "https://bioconductor.org/packages/3.16/bioc/html/RedisParam.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-redisparam", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-redisparam", "html_url": "http://anaconda.org/bioconda/bioconductor-redisparam", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0", "1.12.1"], "latest_version": "1.12.1", "platforms": {"noarch": "1.12.1"}, "conda_platforms": ["noarch"], "revision": 12, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r45hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 5216, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-redisparam/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-redisparam/1.2.0"}, {"version": "1.4.0", "distr