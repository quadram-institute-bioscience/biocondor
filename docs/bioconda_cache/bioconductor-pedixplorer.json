{"name": "bioconductor-pedixplorer", "id": "676229d2ae384d01e1c7f929", "package_types": ["conda"], "summary": "Pedigree Functions", "description": "Routines to handle family data with a Pedigree object. The initial purpose was to create correlation structures that describe family relationships such as kinship and identity-by-descent, which can be used to model family data in mixed effects models, such as in the coxme function. Also includes a tool for Pedigree drawing which is focused on producing compact layouts without intervention. Recent additions include utilities to trim the Pedigree object with various criteria, and kinship for the X chromosome.", "home": "https://bioconductor.org/packages/3.20/bioc/html/Pedixplorer.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-pedixplorer", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-pedixplorer", "html_url": "http://anaconda.org/bioconda/bioconductor-pedixplorer", "versions": ["1.2.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 6, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r45hdfd78af_0"], "ndownloads": 283, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-pedixplorer/1.2.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-pedixplorer/1.6.0"}], "watchers": 1, "upvoted": 0, "created_at": "2024-12-18 01:48:02.644000+00:00", "modified_at": "2026-02-08 09:50:51.764000+00:00", "