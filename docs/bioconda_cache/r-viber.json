{"name": "r-viber", "id": "68226cc07520b133a489e2c6", "package_types": ["conda"], "summary": "Variational Binomial Mixtures.", "description": "VIBER is a package that implements a variational Bayesian model to\nfit multi-variate Binomial mixtures. The statistical model is\nsemi-parametric and fit by a variational mean-field approximation to\nthe model posterior. The components are Binomial distributions which\ncan model count data; these can be used to model sequencing counts in\nthe context of cancer, for instance. The package implements methods to\nfit and visualize clustering results.\n", "home": "https://github.com/caravagnalab/VIBER", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-viber", "url": "http://api.anaconda.org/packages/bioconda/r-viber", "html_url": "http://anaconda.org/bioconda/r-viber", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"noarch": "1.0.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "GPL-3.0-or-later", "license_url": null, "dev_url": null, "doc_url": "https://caravagnalab.github.io/VIBER/", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 478, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/r-viber/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-05-12 21:48:48.173000+00:00", "modified_at": "2025-05-12 21:48:49.680000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/r-viber-1.0.0-r44hdfd78af_0.tar.bz2", "attrs": {"operatingsystem": null, "machine": null, "target-triplet": "None-any-None", "has_prefix