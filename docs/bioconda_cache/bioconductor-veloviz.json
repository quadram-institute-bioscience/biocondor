{"name": "bioconductor-veloviz", "id": "6180247ac16f55df02047731", "package_types": ["conda"], "summary": "VeloViz: RNA-velocity informed 2D embeddings for visualizing cell state trajectories", "description": "VeloViz uses each cell\u2019s current observed and predicted future transcriptional states inferred from RNA velocity analysis to build a nearest neighbor graph between cells in the population. Edges are then pruned based on a cosine correlation threshold and/or a distance threshold and the resulting graph is visualized using a force-directed graph layout algorithm. VeloViz can help ensure that relationships between cell states are reflected in the 2D embedding, allowing for more reliable representation of underlying cellular trajectories.", "home": "https://bioconductor.org/packages/3.14/bioc/html/veloviz.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-veloviz", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-veloviz", "html_url": "http://anaconda.org/bioconda/bioconductor-veloviz", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0", "1.16.0"], "latest_version": "1.16.0", "platforms": {"linux-64": "1.16.0", "osx-64": "1.16.0"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 16, "license": "GPL-3.0-only", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hc247a5b_2", "r41hb890f52_2", "r45hfbc58e1_0", "r41h832b226_0", "r44h35d7169_0", "r41h399db7b_0", "r43hc0ef7c4_0", "r42hc247a5b_0", "r42hf17093f_1", "r43hf17093f_0", "r42hb890f52_1", "r45ha27e39d_0", "r42hf17093f_2", "r42hc0ef7c4_2", "r42h