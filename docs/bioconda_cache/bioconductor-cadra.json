{"name": "bioconductor-cadra", "id": "656f812d5e00d55d7bb82d88", "package_types": ["conda"], "summary": "Candidate Driver Analysis", "description": "Performs both stepwise and backward heuristic search for candidate (epi)genetic drivers based on a binary multi-omics dataset. CaDrA's main objective is to identify features which, together, are significantly skewed or enriched pertaining to a given vector of continuous scores (e.g. sample-specific scores representing a phenotypic readout of interest, such as protein expression, pathway activity, etc.), based on the union occurence (i.e. logical OR) of the events.", "home": "https://bioconductor.org/packages/3.18/bioc/html/CaDrA.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cadra", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cadra", "html_url": "http://anaconda.org/bioconda/bioconductor-cadra", "versions": ["1.0.1"], "latest_version": "1.0.1", "platforms": {"osx-64": "1.0.1", "linux-64": "1.0.1"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 2, "license": "GPL-3 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43ha9d7317_0", "r43h4c50009_0"], "ndownloads": 1231, "releases": [{"version": "1.0.1", "distributions": [], "full_name": "bioconda/bioconductor-cadra/1.0.1"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-05 19:59:41.486000+00:00", "modified_at": "2025-04-22 15:29:39.412000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "osx-64/bioconductor-cadra-1.0.1-r43h