{"name": "bioconductor-outsplice", "id": "64b6bc8db11124f375699943", "package_types": ["conda"], "summary": "Comparison of Splicing Events between Tumor and Normal Samples", "description": "An easy to use tool that can compare splicing events in tumor and normal tissue samples using either a user generated matrix, or data from The Cancer Genome Atlas (TCGA). This package generates a matrix of splicing outliers that are significantly over or underexpressed in tumors samples compared to normal denoted by chromosome location. The package also will calculate the splicing burden in each tumor and characterize the types of splicing events that occur.", "home": "https://bioconductor.org/packages/3.17/bioc/html/OutSplice.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-outsplice", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-outsplice", "html_url": "http://anaconda.org/bioconda/bioconductor-outsplice", "versions": ["1.0.0", "1.2.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 7, "license": "GPL-2", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 3124, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-outsplice/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-outsplice/1.2.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-outsplice/1.6.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-07