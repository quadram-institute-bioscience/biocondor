{"name": "r-tidytacos", "id": "6974c6bb77c126ea528823d0", "package_types": ["conda"], "summary": "Functions to manipulate and visualize microbial community data", "description": "Tidytacos (tidy TAxonomic COmpositionS) is an R package for the exploration of microbial community data. Such community data consists of read counts generated by amplicon sequencing (e.g. a region of the 16S rRNA gene) or metagenome (shotgun) sequencing. Each read count represents a number of sequencing reads identified for some taxon (an ASV, OTU, species, or higher-level taxon) in a sample.", "home": "https://lebeerlab.github.io/tidytacos/", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-tidytacos", "url": "http://api.anaconda.org/packages/bioconda/r-tidytacos", "html_url": "http://anaconda.org/bioconda/r-tidytacos", "versions": ["1.0.8"], "latest_version": "1.0.8", "platforms": {"noarch": "1.0.8"}, "conda_platforms": ["noarch"], "revision": 3, "license": "GPL-3.0-only", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r45hdfd78af_0"], "ndownloads": 20, "releases": [{"version": "1.0.8", "distributions": [], "full_name": "bioconda/r-tidytacos/1.0.8"}], "watchers": 1, "upvoted": 0, "created_at": "2026-01-24 13:18:51.860000+00:00", "modified_at": "2026-01-24 13:18:53.827000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/r-tidytacos-1.0.8-r45hdfd78af_0.conda", "attrs": {"operatingsystem": null, "machine": null, "target-triplet": "None-any-None", "has_prefix": false, "subdir": "noarch", "arch": null,