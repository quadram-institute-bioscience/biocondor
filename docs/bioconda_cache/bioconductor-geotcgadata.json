{"name": "bioconductor-geotcgadata", "id": "64aff0d640fca520451585c6", "package_types": ["conda"], "summary": "Processing Various Types of Data on GEO and TCGA", "description": "Gene Expression Omnibus(GEO) and The Cancer Genome Atlas (TCGA) provide us with a wealth of data, such as RNA-seq, DNA Methylation, SNP and Copy number variation data. It's easy to download data from TCGA using the gdc tool, but processing these data into a format suitable for bioinformatics analysis requires more work. This R package was developed to handle these data.", "home": "https://bioconductor.org/packages/3.17/bioc/html/GeoTcgaData.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-geotcgadata", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-geotcgadata", "html_url": "http://anaconda.org/bioconda/bioconductor-geotcgadata", "versions": ["2.0.0", "2.2.0", "2.6.0"], "latest_version": "2.6.0", "platforms": {"noarch": "2.6.0"}, "conda_platforms": ["noarch"], "revision": 7, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 3172, "releases": [{"version": "2.0.0", "distributions": [], "full_name": "bioconda/bioconductor-geotcgadata/2.0.0"}, {"version": "2.2.0", "distributions": [], "full_name": "bioconda/bioconductor-geotcgadata/2.2.0"}, {"version": "2.6.0", "distributions": [], "full_name": "bioconda/bioconductor-geotcgadata/2.6.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-07-13 12:40:54.675000+00:00", "modified_at": "2025-04-22 15:29:37.865000+00:00", "f