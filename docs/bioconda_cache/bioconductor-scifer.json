{"name": "bioconductor-scifer", "id": "636864cebdd024375c053af2", "package_types": ["conda"], "summary": "Scifer: Single-Cell Immunoglobulin Filtering of Sanger Sequences", "description": "Have you ever index sorted cells in a 96 or 384-well plate and then sequenced using Sanger sequencing? If so, you probably had some struggles to either check the electropherogram of each cell sequenced manually, or when you tried to identify which cell was sorted where after sequencing the plate. Scifer was developed to solve this issue by performing basic quality control of Sanger sequences and merging flow cytometry data from probed single-cell sorted B cells with sequencing data. scifer can export summary tables, 'fasta' files, electropherograms for visual inspection, and generate reports.", "home": "https://bioconductor.org/packages/3.16/bioc/html/scifer.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-scifer", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-scifer", "html_url": "http://anaconda.org/bioconda/bioconductor-scifer", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 5189, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-scifer/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-scifer/1