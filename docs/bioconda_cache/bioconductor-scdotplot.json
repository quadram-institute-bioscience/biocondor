{"name": "bioconductor-scdotplot", "id": "6768e26d49f49e7308ecd963", "package_types": ["conda"], "summary": "Cluster a Single-cell RNA-seq Dot Plot", "description": "Dot plots of single-cell RNA-seq data allow for an examination of the relationships between cell groupings (e.g. clusters) and marker gene expression. The scDotPlot package offers a unified approach to perform a hierarchical clustering analysis and add annotations to the columns and/or rows of a scRNA-seq dot plot. It works with SingleCellExperiment and Seurat objects as well as data frames.", "home": "https://bioconductor.org/packages/3.20/bioc/html/scDotPlot.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-scdotplot", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-scdotplot", "html_url": "http://anaconda.org/bioconda/bioconductor-scdotplot", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"noarch": "1.0.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 331, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-scdotplot/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2024-12-23 04:09:17.528000+00:00", "modified_at": "2025-04-22 15:29:44.012000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/bioconductor-scdotplot-1.0.0-r44hdfd78af_0.tar.bz2", "attrs": {"operatingsystem": null, "machine": null, "target-triplet": "N