{"name": "vcf-pg-loader", "id": "6943c224e20fb3e6b287b103", "package_types": ["conda"], "summary": "High-performance VCF to PostgreSQL loader with clinical-grade compliance", "description": "vcf-pg-loader is a command-line tool for efficiently loading VCF variant data\ninto PostgreSQL databases. It features streaming VCF parsing with cyvcf2,\nvariant normalization using the vt algorithm, proper Number=A/R/G field handling\nduring multi-allelic decomposition, and binary COPY protocol via asyncpg for\nmaximum insert performance.\n", "home": "https://github.com/Zacharyr41/vcf-pg-loader", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/vcf-pg-loader", "url": "http://api.anaconda.org/packages/bioconda/vcf-pg-loader", "html_url": "http://anaconda.org/bioconda/vcf-pg-loader", "versions": ["0.5.1", "0.5.3", "0.5.4"], "latest_version": "0.5.4", "platforms": {"noarch": "0.5.4"}, "conda_platforms": ["noarch"], "revision": 9, "license": "MIT", "license_url": null, "dev_url": "https://github.com/Zacharyr41/vcf-pg-loader", "doc_url": "https://github.com/Zacharyr41/vcf-pg-loader/tree/main/docs", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 162, "releases": [{"version": "0.5.1", "distributions": [], "full_name": "bioconda/vcf-pg-loader/0.5.1"}, {"version": "0.5.3", "distributions": [], "full_name": "bioconda/vcf-pg-loader/0.5.3"}, {"version": "0.5.4", "distributions": [], "full_name": "bioconda/vcf-pg-loader/0.5.4"}], "watchers": 1, "upvoted": 0, "created_at": "2025-12-18 08:58:12.424000+00:00", "modified_at": "2025-12-26 02:22:50.584000+00:00", "files": [{"description": null, "depe