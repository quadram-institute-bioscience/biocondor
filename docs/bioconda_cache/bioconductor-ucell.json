{"name": "bioconductor-ucell", "id": "6367bb39cb9912b2145eadb0", "package_types": ["conda"], "summary": "Rank-based signature enrichment analysis for single-cell data", "description": "UCell is a package for evaluating gene signatures in single-cell datasets. UCell signature scores, based on the Mann-Whitney U statistic, are robust to dataset size and heterogeneity, and their calculation demands less computing time and memory than other available methods, enabling the processing of large datasets in a few minutes even on machines with limited computing power. UCell can be applied to any single-cell data matrix, and includes functions to directly interact with SingleCellExperiment and Seurat objects.", "home": "https://bioconductor.org/packages/3.16/bioc/html/UCell.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-ucell", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-ucell", "html_url": "http://anaconda.org/bioconda/bioconductor-ucell", "versions": ["2.2.0", "2.4.0", "2.6.2", "2.10.1"], "latest_version": "2.10.1", "platforms": {"noarch": "2.10.1"}, "conda_platforms": ["noarch"], "revision": 9, "license": "GPL-3 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 8026, "releases": [{"version": "2.2.0", "distributions": [], "full_name": "bioconda/bioconductor-ucell/2.2.0"}, {"version": "2.4.0", "distributions": [], "full_name": "bioconda/bioconductor-ucell/2.4.0"}, {"version": "2.6.2", "distributions": [], "full_name": "bioconda/biocondu