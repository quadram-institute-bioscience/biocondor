{"name": "hsdecipher", "id": "66f2b65df671e33cf38de06d", "package_types": ["conda"], "summary": "Pipeline for the downstream analysis of highly similar duplicate genes", "description": "Many tools have been developed to measure the degree of similarity between gene duplicates within and between species.Here, we present HSDecipher, a bioinformatics pipeline to assist users in the analysis and visualization of highly similar duplicate genes (HSDs). We describe the steps for analysis of HSDs statistics, expanding HSD gene set, and visualizing the results of comparative genomic analyses. HSDecipher represents a useful tool for researchers exploring the evolution of duplicate genes in select eukaryotic species.", "home": "https://github.com/zx0223winner/HSDecipher", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/hsdecipher", "url": "http://api.anaconda.org/packages/bioconda/hsdecipher", "html_url": "http://anaconda.org/bioconda/hsdecipher", "versions": ["1.0.0", "1.1.1", "1.1.2"], "latest_version": "1.1.2", "platforms": {"noarch": "1.1.2"}, "conda_platforms": ["noarch"], "revision": 10, "license": "GPL-3.0-or-later", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["hdfd78af_0", "hdfd78af_1"], "ndownloads": 1999, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/hsdecipher/1.0.0"}, {"version": "1.1.1", "distributions": [], "full_name": "bioconda/hsdecipher/1.1.1"}, {"version": "1.1.2", "distributions": [], "full_name": "bioconda/hsdecipher/1.1.2"}], "watchers": 1, "upvoted": 0, "created_at": "2024-09-24 12:53:49.414000+00:0