{"name": "bioconductor-smokingmouse", "id": "656ecb76f56ec787b3e7994a", "package_types": ["conda"], "summary": "Provides access to smokingMouse project data", "description": "This is an ExperimentHub package that provides access to the data generated and analyzed in the [smoking-nicotine-mouse](https://github.com/LieberInstitute/smoking-nicotine-mouse/) LIBD project. The datasets contain the expression data of mouse genes, transcripts, exons, and exon-exon junctions across 208 samples from pup and adult mouse brain, and adult blood, that were exposed to nicotine, cigarette smoke, or controls. They also contain relevant metadata of these samples and gene expression features, such QC metrics, if they were used after filtering steps and also if the features were differently expressed in the different experiments.", "home": "https://bioconductor.org/packages/3.18/data/experiment/html/smokingMouse.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-smokingmouse", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-smokingmouse", "html_url": "http://anaconda.org/bioconda/bioconductor-smokingmouse", "versions": ["1.0.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 8, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r45hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 1700, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-smokingmouse/1.0.0"}, {"version": "1.4.0", "distr