{"name": "binspreader", "id": "63cd6670d0e8c095e2f38abc", "package_types": ["conda"], "summary": "BinSPreader is a tool for improving existing binning using assembly\ngraph and other sources of connectivity information\n", "description": "BinSPreader is a novel tool that attempts to refine metagenome-assembled\ngenomes (MAGs) obtained from existing tools. BinSPreader exploits the\nassembly graph topology and other connectivity information, such as\npaired-end and Hi-C reads, to refine the existing binning, correct binning\nerrors, propagate binning from longer contigs to shorter contigs and infer\ncontigs belonging to multiple bins.\n", "home": "https://cab.spbu.ru/software/binspreader/", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/binspreader", "url": "http://api.anaconda.org/packages/bioconda/binspreader", "html_url": "http://anaconda.org/bioconda/binspreader", "versions": ["3.16.0.dev"], "latest_version": "3.16.0.dev", "platforms": {"linux-64": "3.16.0.dev", "osx-64": "3.16.0.dev"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 2, "license": "GPL-2.0-only", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h893b172_0", "h95f258a_0"], "ndownloads": 2085, "releases": [{"version": "3.16.0.dev", "distributions": [], "full_name": "bioconda/binspreader/3.16.0.dev"}], "watchers": 1, "upvoted": 0, "created_at": "2023-01-22 16:38:08.134000+00:00", "modified_at": "2025-04-22 15:29:35.947000+00:00", "files": [{"description": null, "dependencies": [], "distribution_type": "conda", "basename": "linux-64/binspreader-3.16.0.dev-h95f258a_0.tar.bz2