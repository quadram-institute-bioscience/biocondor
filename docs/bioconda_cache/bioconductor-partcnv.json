{"name": "bioconductor-partcnv", "id": "657103e9f8cf2d68ef05c505", "package_types": ["conda"], "summary": "Infer locally aneuploid cells using single cell RNA-seq data", "description": "This package uses a statistical framework for rapid and accurate detection of aneuploid cells with local copy number deletion or amplification. Our method uses an EM algorithm with mixtures of Poisson distributions while incorporating cytogenetics information (e.g., regional deletion or amplification) to guide the classification (partCNV). When applicable, we further improve the accuracy by integrating a Hidden Markov Model for feature selection (partCNVH).", "home": "https://bioconductor.org/packages/3.18/bioc/html/partCNV.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-partcnv", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-partcnv", "html_url": "http://anaconda.org/bioconda/bioconductor-partcnv", "versions": ["1.0.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "GPL-2", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 1667, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-partcnv/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-partcnv/1.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-06 23:29:45.031000+00:00", "modified_at": "2025-04-22 15:29:39.493000+00:00", "files": [{"description": null, "dependencie