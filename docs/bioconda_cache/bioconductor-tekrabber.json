{"name": "bioconductor-tekrabber", "id": "636af92a9b05a354c8e91bfb", "package_types": ["conda"], "summary": "An R package estimates the correlations of orthologs and transposable elements between two species", "description": "TEKRABber is made to provide a user-friendly pipeline for comparing orthologs and transposable elements (TEs) between two species. It considers the orthology confidence between two species from BioMart to normalize expression counts and detect differentially expressed orthologs/TEs. Then it provides one to one correlation analysis for desired orthologs and TEs. There is also an app function to have a first insight on the result. Users can prepare orthologs/TEs RNA-seq expression data by their own preference to run TEKRABber following the data structure mentioned in the vignettes.", "home": "https://bioconductor.org/packages/3.16/bioc/html/TEKRABber.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-tekrabber", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-tekrabber", "html_url": "http://anaconda.org/bioconda/bioconductor-tekrabber", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"linux-64": "1.10.0", "osx-64": "1.10.0"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 10, "license": "LGPL (>=3)", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hf17093f_1", "r44h35d7169_0", "r42hb890f52_0", "r43hc0ef7c4_0", "r43hf17093f_0", "r42hc0ef7c4_1", "r42hc247a5b_0", "r44he5774e6_0"], "ndownloads": 5720, "releases": [{"version": "1.2.0", "distrib