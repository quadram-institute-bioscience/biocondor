{"name": "eukbin", "id": "698dde5549903ca4bc49a23f", "package_types": ["conda"], "summary": "BUSCO-guided binning for eukaryotic metagenomes", "description": "EukBin is a specialized binning tool for eukaryotic metagenomes that combines\nrepeat-masked tetranucleotide frequency (TNF), multi-sample coverage information,\nBUSCO marker gene constraints, and deep learning (\u03b2-VAE with contrastive loss)\nwith ploidy-aware refinement.\n\nKey features:\n- Repeat-masked TNF features to handle repeat-rich eukaryotic genomes\n- BUSCO-guided constraints for accurate bin estimation\n- Ploidy-aware refinement (haplotig detection for diploid/polyploid genomes)\n- Deep learning with \u03b2-VAE and contrastive loss\n- Supports multi-sample binning\n\nThis package includes:\n- eukbin run: Complete binning pipeline (M1-M6 modules)\n- eukbin evaluate: Quality assessment for any binning tool\n- eukbin report: Multi-tool comparison report\n", "home": "https://github.com/weiwei12456/eukbin", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/eukbin", "url": "http://api.anaconda.org/packages/bioconda/eukbin", "html_url": "http://anaconda.org/bioconda/eukbin", "versions": ["0.1.0"], "latest_version": "0.1.0", "platforms": {"noarch": "0.1.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT", "license_url": null, "dev_url": "https://github.com/weiwei12456/eukbin", "doc_url": "https://github.com/weiwei12456/eukbin/blob/main/README.md", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["py314hdfd78af_0"], "ndownloads": 22, "releases": [{"version": "0.1.0", "distributions": [], "full_name": "bioconda/eukbin/0.1.0"}]