{"name": "bioconductor-busseq", "id": "6182b2f3f4b13bda459cdad2", "package_types": ["conda"], "summary": "Batch Effect Correction with Unknow Subtypes for scRNA-seq data", "description": "BUSseq R package fits an interpretable Bayesian hierarchical model---the Batch Effects Correction with Unknown Subtypes for scRNA seq Data (BUSseq)---to correct batch effects in the presence of unknown cell types. BUSseq is able to simultaneously correct batch effects, clusters cell types, and takes care of the count data nature, the overdispersion, the dropout events, and the cell-specific sequencing depth of scRNA-seq data. After correcting the batch effects with BUSseq, the corrected value can be used for downstream analysis as if all cells were sequenced in a single batch. BUSseq can integrate read count matrices obtained from different scRNA-seq platforms and allow cell types to be measured in some but not all of the batches as long as the experimental design fulfills the conditions listed in our manuscript.", "home": "https://bioconductor.org/packages/3.14/bioc/html/BUSseq.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-busseq", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-busseq", "html_url": "http://anaconda.org/bioconda/bioconductor-busseq", "versions": ["1.0.0", "1.4.0", "1.6.1", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"linux-64": "1.12.0", "osx-64": "1.12.0"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 12, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": [