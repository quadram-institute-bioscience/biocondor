{"name": "bioconductor-bsgenome.btaurus.ucsc.bostau9.masked", "id": "6369b070de9ed7eca6f5b4aa", "package_types": ["conda"], "summary": "Full masked genome sequences for Bos taurus (UCSC version bosTau9)", "description": "Full genome sequences for Bos taurus (Cow) as provided by UCSC (genome bosTau9) and stored in Biostrings objects. The sequences are the same as in BSgenome.Btaurus.UCSC.bosTau9, except that each of them has the 4 following masks on top: (1) the mask of assembly gaps (AGAPS mask), (2) the mask of intra-contig ambiguities (AMB mask), (3) the mask of repeats from RepeatMasker (RM mask), and (4) the mask of repeats from Tandem Repeats Finder (TRF mask). Only the AGAPS and AMB masks are \"active\" by default.", "home": "https://bioconductor.org/packages/3.16/data/annotation/html/BSgenome.Btaurus.UCSC.bosTau9.masked.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-bsgenome.btaurus.ucsc.bostau9.masked", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-bsgenome.btaurus.ucsc.bostau9.masked", "html_url": "http://anaconda.org/bioconda/bioconductor-bsgenome.btaurus.ucsc.bostau9.masked", "versions": ["1.4.4"], "latest_version": "1.4.4", "platforms": {"noarch": "1.4.4"}, "conda_platforms": ["noarch"], "revision": 3, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_3", "r43hdfd78af_2", "r42hdfd78af_0", "r43hdfd78af_1"], "ndownloads": 1776, "releases": [{"version": "1.4.4", "distributions": [], "full_name": "bioconda/bioconductor-bsgenome.btaurus.ucsc.bostau9.masked/1.4.4"}]