{"name": "te-aid", "id": "67caa41ff8071f5a8773878f", "package_types": ["conda"], "summary": "Annotation helper tool for the manual curation of transposable element consensus sequences", "description": "TE-Aid is a shell+R program aimed to help the manual curation of transposable\nelements (TE). It inputs a TE consensus sequence (fasta format) and requires a\nreference genome (in fasta as well). TE-Aid produces 4 figures reporting i) the genomic\nhits with divergence to consensus, ii) the genomic coverage of the consensus,\niii) a self dot-plot, and iv) a structure analysis including TIR and LTR suggestions,\nopen reading frames (ORFs) and TE protein hit annotation.\n", "home": "https://github.com/clemgoub/TE-Aid/tree/v{version}", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/te-aid", "url": "http://api.anaconda.org/packages/bioconda/te-aid", "html_url": "http://anaconda.org/bioconda/te-aid", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"noarch": "1.0.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT", "license_url": null, "dev_url": "https://github.com/clemgoub/TE-Aid", "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["hdfd78af_0"], "ndownloads": 117, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/te-aid/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-03-07 07:45:35.849000+00:00", "modified_at": "2025-04-22 15:29:44.984000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/te-aid-1.0.0-hdfd78af_0.tar.bz2", "attrs": {"operatingsystem": null