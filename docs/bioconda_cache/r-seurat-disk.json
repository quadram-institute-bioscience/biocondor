{"name": "r-seurat-disk", "id": "65f48054396d5723c011fd4f", "package_types": ["conda"], "summary": "The h5Seurat file format is specifically designed for the storage and analysis of multi-modal single-cell and spatially-resolved expression experiments, for example, from CITE-seq or 10X Visium technologies. It holds all molecular information and associated metadata, including (for example) nearest-neighbor graphs, dimensional reduction information, spatial coordinates and image data, and cluster labels. We also support rapid and on-disk conversion between h5Seurat and AnnData objects, with the goal of enhancing interoperability between Seurat and Scanpy.", "description": "", "home": "https://mojaveazure.github.io/seurat-disk/", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-seurat-disk", "url": "http://api.anaconda.org/packages/bioconda/r-seurat-disk", "html_url": "http://anaconda.org/bioconda/r-seurat-disk", "versions": ["0.0.0.9021"], "latest_version": "0.0.0.9021", "platforms": {"linux-64": "0.0.0.9021", "osx-64": "0.0.0.9021", "noarch": "0.0.0.9021"}, "conda_platforms": ["noarch", "osx-64", "linux-64"], "revision": 7, "license": "GPL-3.0-only", "license_url": null, "dev_url": "https://github.com/mojaveazure/seurat-disk", "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44h527b516_1", "r43h527b516_0", "r43h9ee0642_0", "r44hdfd78af_2", "r44h9ee0642_1"], "ndownloads": 2989, "releases": [{"version": "0.0.0.9021", "distributions": [], "full_name": "bioconda/r-seurat-disk/0.0.0.9021"}], "watchers": 1, "upvoted": 0, "created_at": "2024-03-15 17:07:32.188000+00:00", "modified_at": "20