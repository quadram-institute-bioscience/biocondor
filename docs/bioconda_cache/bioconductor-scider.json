{"name": "bioconductor-scider", "id": "65710c7566cf6505a5f023f1", "package_types": ["conda"], "summary": "Spatial cell-type inter-correlation by density in R", "description": "scider is a user-friendly R package providing functions to model the global density of cells in a slide of spatial transcriptomics data. All functions in the package are built based on the SpatialExperiment object, allowing integration into various spatial transcriptomics-related packages from Bioconductor. After modelling density, the package allows for serveral downstream analysis, including colocalization analysis, boundary detection analysis and differential density analysis.", "home": "https://bioconductor.org/packages/3.18/bioc/html/scider.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-scider", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-scider", "html_url": "http://anaconda.org/bioconda/bioconductor-scider", "versions": ["1.0.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "GPL-3 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 537, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-scider/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-scider/1.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-07 00:06:13.320000+00:00", "modified_at": "2025-04-22 15:29:39.499000+00:00", "files": [{"description