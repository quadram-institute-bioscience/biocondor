{"name": "r-shazam", "id": "5ae2fd248f21fa11f9cb7b92", "package_types": ["conda"], "summary": "Provides a computational framework for analyzing mutations in immunoglobulin (Ig) sequences. Includes methods for Bayesian estimation of antigen-driven selection pressure, mutational load quantification, building of somatic hypermutation (SHM) models, and model-dependent distance calculations. Also includes empirically derived models of SHM for both mice and humans. Citations: Gupta and Vander Heiden, et al (2015) <doi:10.1093/bioinformatics/btv359>, Yaari, et al (2012) <doi:10.1093/nar/gks457>, Yaari, et al (2013) <doi:10.3389/fimmu.2013.00358>, Cui, et al (2016) <doi:10.4049/jimmunol.1502263>.", "description": "", "home": "http", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-shazam", "url": "http://api.anaconda.org/packages/bioconda/r-shazam", "html_url": "http://anaconda.org/bioconda/r-shazam", "versions": ["0.1.9", "0.1.10", "0.1.11", "0.2.1", "0.2.2", "0.2.3", "1.1.0", "1.1.2"], "latest_version": "1.1.2", "platforms": {"linux-64": "0.1.11", "osx-64": "0.1.11", "noarch": "1.1.2"}, "conda_platforms": ["noarch", "osx-64", "linux-64"], "revision": 16, "license": "AGPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r36h6115d3f_0", "r40h6115d3f_1", "r41h3121a25_0", "r36h6115d3f_1", "r351h6115d3f_0", "r351h6115d3f_1", "r42h3121a25_1", "r3.4.1_2", "r341h6115d3f_0"], "ndownloads": 32116, "releases": [{"version": "0.1.9", "distributions": [], "full_name": "bioconda/r-shazam/0.1.9"}, {"version": "0.1.10", "distributions": [], "full_name": "bioconda/