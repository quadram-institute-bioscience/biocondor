{"name": "bioconductor-gosorensen", "id": "636934314c56ddbcd9c70c26", "package_types": ["conda"], "summary": "Statistical inference based on the Sorensen-Dice dissimilarity and the Gene Ontology (GO)", "description": "This package implements inferential methods to compare gene lists in terms of their biological meaning as expressed in the GO. The compared gene lists are characterized by cross-tabulation frequency tables of enriched GO items. Dissimilarity between gene lists is evaluated using the Sorensen-Dice index. The fundamental guiding principle is that two gene lists are taken as similar if they share a great proportion of common enriched GO items.", "home": "https://bioconductor.org/packages/3.16/bioc/html/goSorensen.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-gosorensen", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-gosorensen", "html_url": "http://anaconda.org/bioconda/bioconductor-gosorensen", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 5075, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-gosorensen/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-gosorensen/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-gosorensen/1.4.0"}, {"version