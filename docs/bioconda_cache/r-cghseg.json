{"name": "r-cghseg", "id": "636b70599d86323decfb987f", "package_types": ["conda"], "summary": "Dedicated to the analysis of CGH (Comparative Genomic Hybridization) array profiles using segmentation models. 'cghseg' package is intended to detect breakpoints from CGH profiles. It can handle both single and multiple profiles analysis, to perform segmentation, normalization and calling. Methods for joint segmentation are described in Picard and al. (2011).", "description": "", "home": "https://CRAN.R-project.org/package=cghseg", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-cghseg", "url": "http://api.anaconda.org/packages/bioconda/r-cghseg", "html_url": "http://anaconda.org/bioconda/r-cghseg", "versions": ["1.0.5"], "latest_version": "1.0.5", "platforms": {"noarch": "1.0.5"}, "conda_platforms": ["noarch"], "revision": 2, "license": "GPL (>= 2)", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r40h3121a25_3", "r41h3121a25_0", "r40h3121a25_2", "r42h3121a25_1"], "ndownloads": 2554, "releases": [{"version": "1.0.5", "distributions": [], "full_name": "bioconda/r-cghseg/1.0.5"}], "watchers": 1, "upvoted": 0, "created_at": "2022-11-09 09:18:17.419000+00:00", "modified_at": "2025-04-22 15:29:35.220000+00:00", "files": [{"description": null, "dependencies": [], "distribution_type": "conda", "basename": "noarch/r-cghseg-1.0.5-r41h3121a25_0.tar.bz2", "attrs": {"build_number": 0, "license": "GPL (>= 2)", "has_prefix": false, "license_family": "GPL3", "noarch": "generic", "machine": null, "platform": null, "depends": ["r-base >=4.1,<4.2.0a0"], "build": "r41