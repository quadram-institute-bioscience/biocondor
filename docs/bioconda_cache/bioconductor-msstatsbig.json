{"name": "bioconductor-msstatsbig", "id": "656e74fd8db0d2441225c208", "package_types": ["conda"], "summary": "MSstats Preprocessing for Larger than Memory Data", "description": "MSstats package provide tools for preprocessing, summarization and differential analysis of mass spectrometry (MS) proteomics data. Recently, some MS protocols enable acquisition of data sets that result in larger than memory quantitative data. MSstats functions are not able to process such data. MSstatsBig package provides additional converter functions that enable processing larger than memory data sets.", "home": "https://bioconductor.org/packages/3.18/bioc/html/MSstatsBig.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-msstatsbig", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-msstatsbig", "html_url": "http://anaconda.org/bioconda/bioconductor-msstatsbig", "versions": ["1.0.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 1366, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-msstatsbig/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-msstatsbig/1.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-05 00:55:25.195000+00:00", "modified_at": "2025-04-22 15:29:39.355000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type