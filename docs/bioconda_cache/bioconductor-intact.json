{"name": "bioconductor-intact", "id": "64a7d9e29ee035b003d9c10f", "package_types": ["conda"], "summary": "Integrate TWAS and Colocalization Analysis for Gene Set Enrichment Analysis", "description": "This package integrates colocalization probabilities from colocalization analysis with transcriptome-wide association study (TWAS) scan summary statistics to implicate genes that may be biologically relevant to a complex trait. The probabilistic framework implemented in this package constrains the TWAS scan z-score-based likelihood using a gene-level colocalization probability. Given gene set annotations, this package can estimate gene set enrichment using posterior probabilities from the TWAS-colocalization integration step.", "home": "https://bioconductor.org/packages/3.17/bioc/html/INTACT.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-intact", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-intact", "html_url": "http://anaconda.org/bioconda/bioconductor-intact", "versions": ["1.0.1", "1.2.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 10, "license": "GPL-3 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r45hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 3236, "releases": [{"version": "1.0.1", "distributions": [], "full_name": "bioconda/bioconductor-intact/1.0.1"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-intact/1.2.0"}, {"version": "1.6.0", "distributions": [], "