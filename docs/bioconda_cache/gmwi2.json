{"name": "gmwi2", "id": "651c369904805aa00cc284bc", "package_types": ["conda"], "summary": "Enhanced Health Status Prediction from Gut Microbiome Taxonomic Profiles", "description": "GMWI2 (Gut Microbiome Wellness Index 2) is a robust and biologically interpretable predictor of health status based on gut microbiome taxonomic profiles.\nOn a stool metagenome sample, this command-line tool performs four major steps:\n(1) Quality control;\n(2) Taxonomic profiling using MetaPhlAn3 (v3.0.13) with the mpa\\_v30\\_CHOCOPhlAn_201901 marker database;\n(3) Transformation of taxonomic relative abundances into a binary presence/absence profile;\n(4) Computation of the GMWI2 score using a Lasso-penalized logistic regression model trained on a meta-dataset of 8,069 health status labeled stool shotgun metagenomes.\n", "home": "https://github.com/danielchang2002/GMWI2", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/gmwi2", "url": "http://api.anaconda.org/packages/bioconda/gmwi2", "html_url": "http://anaconda.org/bioconda/gmwi2", "versions": ["1.5", "1.6"], "latest_version": "1.6", "platforms": {"noarch": "1.6"}, "conda_platforms": ["noarch"], "revision": 5, "license": "MIT", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 1953, "releases": [{"version": "1.5", "distributions": [], "full_name": "bioconda/gmwi2/1.5"}, {"version": "1.6", "distributions": [], "full_name": "bioconda/gmwi2/1.6"}], "watchers": 1, "upvoted": 0, "created_at": "2023-10-03 15:43:21.985000+00:00", "modified_at": "2025-04-22 15:29:38.721000+00:00", "files": [{