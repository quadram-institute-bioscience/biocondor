{"name": "bioconductor-epicompare", "id": "636c3abd4d5193fdfc3dd988", "package_types": ["conda"], "summary": "Comparison, Benchmarking & QC of Epigenomic Datasets", "description": "EpiCompare is used to compare and analyse epigenetic datasets for quality control and benchmarking purposes. The package outputs an HTML report consisting of three sections: (1. General metrics) Metrics on peaks (percentage of blacklisted and non-standard peaks, and peak widths) and fragments (duplication rate) of samples, (2. Peak overlap) Percentage and statistical significance of overlapping and non-overlapping peaks. Also includes upset plot and (3. Functional annotation) functional annotation (ChromHMM, ChIPseeker and enrichment analysis) of peaks. Also includes peak enrichment around TSS.", "home": "https://bioconductor.org/packages/3.16/bioc/html/EpiCompare.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-epicompare", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-epicompare", "html_url": "http://anaconda.org/bioconda/bioconductor-epicompare", "versions": ["1.2.0", "1.4.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 7, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 4011, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-epicompare/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-epicompare/1.