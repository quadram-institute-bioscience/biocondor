{"name": "bioconductor-spotclean", "id": "6367271046f81babca695326", "package_types": ["conda"], "summary": "SpotClean adjusts for spot swapping in spatial transcriptomics data", "description": "SpotClean is a computational method to adjust for spot swapping in spatial transcriptomics data. Recent spatial transcriptomics experiments utilize slides containing thousands of spots with spot-specific barcodes that bind mRNA. Ideally, unique molecular identifiers at a spot measure spot-specific expression, but this is often not the case due to bleed from nearby spots, an artifact we refer to as spot swapping. SpotClean is able to estimate the contamination rate in observed data and decontaminate the spot swapping effect, thus increase the sensitivity and precision of downstream analyses.", "home": "https://bioconductor.org/packages/3.16/bioc/html/SpotClean.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-spotclean", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-spotclean", "html_url": "http://anaconda.org/bioconda/bioconductor-spotclean", "versions": ["1.0.0", "1.2.0", "1.4.1", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 4404, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-spotclean/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-sp