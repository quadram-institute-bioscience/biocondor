{"name": "bioconductor-synaptome.data", "id": "618820b97fc781d3ff057a57", "package_types": ["conda"], "summary": "AnnotationData for Synaptome.DB package", "description": "The package provides access to the copy of the Synaptic proteome database. It was designed as an accompaniment for Synaptome.DB package. Database provides information for specific synaptic genes and allows building the protein-protein interaction graph for gene sets, synaptic compartments, and brain regions. In the current update we added 6 more synaptic proteome studies, which resulted in total of 64 studies. We introduced Synaptic Vesicle as a separate compartment. We also added coding mutations for Autistic Spectral disorder and Epilepsy collected from publicly available databases.", "home": "https://bioconductor.org/packages/3.14/data/annotation/html/synaptome.data.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-synaptome.data", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-synaptome.data", "html_url": "http://anaconda.org/bioconda/bioconductor-synaptome.data", "versions": ["0.99.3", "0.99.6"], "latest_version": "0.99.6", "platforms": {"noarch": "0.99.6"}, "conda_platforms": ["noarch"], "revision": 5, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_3", "r41hdfd78af_0", "r43hdfd78af_2", "r41hdfd78af_1", "r42hdfd78af_0", "r43hdfd78af_1"], "ndownloads": 3543, "releases": [{"version": "0.99.3", "distributions": [], "full_name": "bioconda/bioconductor-synaptome.data/0.99.3"}, {"version": "0.99.6", "dist