{"name": "bioconductor-sipsic", "id": "64ae675d280e217a8346ef7c", "package_types": ["conda"], "summary": "Calculate Pathway Scores for Each Cell in scRNA-Seq Data", "description": "Infer biological pathway activity of cells from single-cell RNA-sequencing data by calculating a pathway score for each cell (pathway genes are specified by the user). It is recommended to have the data in Transcripts-Per-Million (TPM) or Counts-Per-Million (CPM) units for best results. Scores may change when adding cells to or removing cells off the data. SiPSiC stands for Single Pathway analysis in Single Cells.", "home": "https://bioconductor.org/packages/3.17/bioc/html/SiPSiC.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-sipsic", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-sipsic", "html_url": "http://anaconda.org/bioconda/bioconductor-sipsic", "versions": ["1.0.0", "1.2.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 7, "license": "file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 3104, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-sipsic/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-sipsic/1.2.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-sipsic/1.6.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-07-12 08:42:05.093000+00:00", "modified_at": "2025-04-22 15:29:37.8440