{"name": "bioconductor-tpsvg", "id": "6767fd3455b9451475e98021", "package_types": ["conda"], "summary": "Thin plate models to detect spatially variable genes", "description": "The goal of `tpSVG` is to detect and visualize spatial variation in the gene expression for spatially resolved transcriptomics data analysis. Specifically, `tpSVG` introduces a family of count-based models, with generalizable parametric assumptions such as Poisson distribution or negative binomial distribution. In addition, comparing to currently available count-based model for spatially resolved data analysis, the `tpSVG` models improves computational time, and hence greatly improves the applicability of count-based models in SRT data analysis.", "home": "https://bioconductor.org/packages/3.20/bioc/html/tpSVG.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-tpsvg", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-tpsvg", "html_url": "http://anaconda.org/bioconda/bioconductor-tpsvg", "versions": ["1.2.0"], "latest_version": "1.2.0", "platforms": {"noarch": "1.2.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 193, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-tpsvg/1.2.0"}], "watchers": 1, "upvoted": 0, "created_at": "2024-12-22 11:51:16.579000+00:00", "modified_at": "2025-04-22 15:29:43.953000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "