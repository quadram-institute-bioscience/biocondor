{"name": "r-lipidomer", "id": "62e5040d87b452646a8524d5", "package_types": ["conda"], "summary": "Create lipidome-wide heatmaps of statistics with the 'lipidomeR'. The 'lipidomeR' provides a streamlined pipeline for the systematic interpretation of the lipidome through publication-ready visualizations of regression models fitted on lipidomics data. With 'lipidomeR', associations between covariates and the lipidome can be interpreted systematically and intuitively through heatmaps, where lipids are categorized by the lipid class and are presented on two-dimensional maps organized by the lipid size and level of saturation. This way, the 'lipidomeR' helps you gain an immediate understanding of the multivariate patterns in the lipidome already at first glance. You can create lipidome-wide heatmaps of statistical associations, changes, differences, variation, or other lipid-specific values. The heatmaps are provided with publication-ready quality and the results behind the visualizations are based on rigorous statistical models.", "description": "", "home": "https://tommi-s.github.io/", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-lipidomer", "url": "http://api.anaconda.org/packages/bioconda/r-lipidomer", "html_url": "http://anaconda.org/bioconda/r-lipidomer", "versions": ["0.1.2"], "latest_version": "0.1.2", "platforms": {"noarch": "0.1.2"}, "conda_platforms": ["noarch"], "revision": 2, "license": "GPL-3.0-only", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42h3121a25_1", "r43h3121a25_2", "r41h3121a25_0"], "ndownloads": 2491, "releases": [{