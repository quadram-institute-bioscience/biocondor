{"name": "bioconductor-orthos", "id": "6575640d4b81e0fea8c04a2e", "package_types": ["conda"], "summary": "`orthos` is an R package for variance decomposition using conditional variational auto-encoders", "description": "`orthos` decomposes RNA-seq contrasts, for example obtained from a gene knock-out or compound treatment experiment, into unspecific and experiment-specific components. Original and decomposed contrasts can be efficiently queried against a large database of contrasts (derived from ARCHS4, https://maayanlab.cloud/archs4/) to identify similar experiments. `orthos` furthermore provides plotting functions to visualize the results of such a search for similar contrasts.", "home": "https://bioconductor.org/packages/3.18/bioc/html/orthos.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-orthos", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-orthos", "html_url": "http://anaconda.org/bioconda/bioconductor-orthos", "versions": ["1.0.1", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 1628, "releases": [{"version": "1.0.1", "distributions": [], "full_name": "bioconda/bioconductor-orthos/1.0.1"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-orthos/1.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-10 07:09:01.706000+00:00", "modified_at": "2025-04-22 15:29:39.645000+00:0