{"name": "alphafill", "id": "6886acc51e3c4b9f34cea871", "package_types": ["conda"], "summary": "Transplant missing compounds to the AlphaFold models", "description": "AlphaFill is an algorithm based on sequence and structure similarity that \u201ctransplants\u201d missing ligands, cofactors and (metal) ions to the AlphaFold models.\nBy adding the molecular context to these protein structures, the models can be more easily appreciated in terms of function and structural integrity.\nConsequently, the AlphaFill models can be helpful in designing downstream wet-lab experiments and/or computational studies.\n", "home": "https://alphafill.eu", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/alphafill", "url": "http://api.anaconda.org/packages/bioconda/alphafill", "html_url": "http://anaconda.org/bioconda/alphafill", "versions": ["2.2.0"], "latest_version": "2.2.0", "platforms": {"linux-aarch64": "2.2.0", "linux-64": "2.2.0", "osx-64": "2.2.0", "osx-arm64": "2.2.0"}, "conda_platforms": ["linux-aarch64", "osx-64", "linux-64", "osx-arm64"], "revision": 6, "license": "BSD-2-Clause", "license_url": null, "dev_url": "https://github.com/PDB-REDO/alphafill", "doc_url": "https://alphafill.eu/manual", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h639dec6_0", "h3f0cd99_0", "hb6cdc16_0", "haf24da9_0"], "ndownloads": 347, "releases": [{"version": "2.2.0", "distributions": [], "full_name": "bioconda/alphafill/2.2.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-07-27 22:48:37.210000+00:00", "modified_at": "2025-07-27 23:00:13.371000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribu