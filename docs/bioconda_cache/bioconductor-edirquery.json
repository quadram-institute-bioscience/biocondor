{"name": "bioconductor-edirquery", "id": "64ad9a5fbf30b7c6a5ce6e08", "package_types": ["conda"], "summary": "Query the EDIR Database For Specific Gene", "description": "EDIRquery provides a tool to search for genes of interest within the Exome Database of Interspersed Repeats (EDIR). A gene name is a required input, and users can additionally specify repeat sequence lengths, minimum and maximum distance between sequences, and whether to allow a 1-bp mismatch. Outputs include a summary of results by repeat length, as well as a dataframe of query results. Example data provided includes a subset of the data for the gene GAA (ENSG00000171298). To query the full database requires providing a path to the downloaded database files as a parameter.", "home": "https://bioconductor.org/packages/3.17/bioc/html/EDIRquery.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-edirquery", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-edirquery", "html_url": "http://anaconda.org/bioconda/bioconductor-edirquery", "versions": ["1.0.0", "1.2.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 7, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 3164, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-edirquery/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-edirquery/1.2.0"}, {"version": "1.6.0", "distributions": [], "full_name