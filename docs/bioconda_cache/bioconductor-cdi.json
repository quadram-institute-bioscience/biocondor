{"name": "bioconductor-cdi", "id": "658b38b64b3073b879b4c50b", "package_types": ["conda"], "summary": "Clustering Deviation Index (CDI)", "description": "Single-cell RNA-sequencing (scRNA-seq) is widely used to explore cellular variation. The analysis of scRNA-seq data often starts from clustering cells into subpopulations. This initial step has a high impact on downstream analyses, and hence it is important to be accurate. However, there have not been unsupervised metric designed for scRNA-seq to evaluate clustering performance. Hence, we propose clustering deviation index (CDI), an unsupervised metric based on the modeling of scRNA-seq UMI counts to evaluate clustering of cells.", "home": "https://bioconductor.org/packages/3.18/bioc/html/CDI.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cdi", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cdi", "html_url": "http://anaconda.org/bioconda/bioconductor-cdi", "versions": ["1.0.2", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "GPL-3 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 1280, "releases": [{"version": "1.0.2", "distributions": [], "full_name": "bioconda/bioconductor-cdi/1.0.2"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-cdi/1.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-26 20:33:58.679000+00:00", "modified_at": "2025-04-22 15:29:39.985000+00:00", "files": [{