{"name": "bioconductor-metaboannotation", "id": "6367982ccecfaf2e85b5dc7e", "package_types": ["conda"], "summary": "Utilities for Annotation of Metabolomics Data", "description": "High level functions to assist in annotation of (metabolomics) data sets. These include functions to perform simple tentative annotations based on mass matching but also functions to consider m/z and retention times for annotation of LC-MS features given that respective reference values are available. In addition, the function provides high-level functions to simplify matching of LC-MS/MS spectra against spectral libraries and objects and functionality to represent and manage such matched data.", "home": "https://bioconductor.org/packages/3.16/bioc/html/MetaboAnnotation.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-metaboannotation", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-metaboannotation", "html_url": "http://anaconda.org/bioconda/bioconductor-metaboannotation", "versions": ["1.2.0", "1.4.1", "1.6.1", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 5473, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-metaboannotation/1.2.0"}, {"version": "1.4.1", "distributions": [], "full_name": "bioconda/bioconductor-metaboannotation/1.4.1"}, {"version": "1.6.1", "distributions": [], "f