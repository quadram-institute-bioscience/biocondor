{"name": "bioconductor-easycelltype", "id": "63692fe8493a4c89d4526410", "package_types": ["conda"], "summary": "Annotate cell types for scRNA-seq data", "description": "We developed EasyCellType which can automatically examine the input marker lists obtained from existing software such as Seurat over the cell markerdatabases. Two quantification approaches to annotate cell types are provided: Gene set enrichment analysis (GSEA) and a modified versio of Fisher's exact test. The function presents annotation recommendations in graphical outcomes: bar plots for each cluster showing candidate cell types, as well as a dot plot summarizing the top 5 significant annotations for each cluster.", "home": "https://bioconductor.org/packages/3.16/bioc/html/EasyCellType.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-easycelltype", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-easycelltype", "html_url": "http://anaconda.org/bioconda/bioconductor-easycelltype", "versions": ["1.0.0", "1.2.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 7, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 3768, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-easycelltype/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-easycelltype/1.2.0"}, {"version": "1.8.0", "distributions": [], "full_name": "bioconda/bio