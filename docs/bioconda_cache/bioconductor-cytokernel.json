{"name": "bioconductor-cytokernel", "id": "6181ae5e5884df75bfe798ce", "package_types": ["conda"], "summary": "Differential expression using kernel-based score test", "description": "cytoKernel implements a kernel-based score test to identify differentially expressed features in high-dimensional biological experiments. This approach can be applied across many different high-dimensional biological data including gene expression data and dimensionally reduced cytometry-based marker expression data. In this R package, we implement functions that compute the feature-wise p values and their corresponding adjusted p values. Additionally, it also computes the feature-wise shrunk effect sizes and their corresponding shrunken effect size. Further, it calculates the percent of differentially expressed features and plots user-friendly heatmap of the top differentially expressed features on the rows and samples on the columns.", "home": "https://bioconductor.org/packages/3.14/bioc/html/cytoKernel.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cytokernel", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cytokernel", "html_url": "http://anaconda.org/bioconda/bioconductor-cytokernel", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"linux-64": "1.12.0", "osx-64": "1.12.0"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 12, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hc0ef7c4_1", "r41hc247a5b_2", "r41h7cba510_1", "r41hb890f52_2", "r41h399