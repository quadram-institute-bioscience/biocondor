{"name": "bioconductor-crisprscore", "id": "636d468fbc29e050d5244679", "package_types": ["conda"], "summary": "On-Target and Off-Target Scoring Algorithms for CRISPR gRNAs", "description": "Provides R wrappers of several on-target and off-target scoring methods for CRISPR guide RNAs (gRNAs). The following nucleases are supported: SpCas9, AsCas12a, enAsCas12a, and RfxCas13d (CasRx). The available on-target cutting efficiency scoring methods are RuleSet1, Azimuth, DeepHF, DeepCpf1, enPAM+GB, and CRISPRscan. Both the CFD and MIT scoring methods are available for off-target specificity prediction. The package also provides a Lindel-derived score to predict the probability of a gRNA to produce indels inducing a frameshift for the Cas9 nuclease. Note that DeepHF, DeepCpf1 and enPAM+GB are not available on Windows machines.", "home": "https://bioconductor.org/packages/3.16/bioc/html/crisprScore.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-crisprscore", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-crisprscore", "html_url": "http://anaconda.org/bioconda/bioconductor-crisprscore", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 5396, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-crisprscore/1.2.0"}, {"version": "1.4.0