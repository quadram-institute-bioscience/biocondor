{"name": "bioconductor-scddboost", "id": "63670b609b05a354c872c270", "package_types": ["conda"], "summary": "A compositional model to assess expression changes from single-cell rna-seq data", "description": "scDDboost is an R package to analyze changes in the distribution of single-cell expression data between two experimental conditions. Compared to other methods that assess differential expression, scDDboost benefits uniquely from information conveyed by the clustering of cells into cellular subtypes. Through a novel empirical Bayesian formulation it calculates gene-specific posterior probabilities that the marginal expression distribution is the same (or different) between the two conditions. The implementation in scDDboost treats gene-level expression data within each condition as a mixture of negative binomial distributions.", "home": "https://bioconductor.org/packages/3.16/bioc/html/scDDboost.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-scddboost", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-scddboost", "html_url": "http://anaconda.org/bioconda/bioconductor-scddboost", "versions": ["1.0.0", "1.2.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"linux-64": "1.4.0", "osx-64": "1.4.0"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 6, "license": "GPL (>= 2)", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hf17093f_1", "r43hc0ef7c4_0", "r42hb890f52_0", "r43hf17093f_0", "r42hc247a5b_0", "r42hc0ef7c4_1"], "ndownloads": 3387, "releases": [{"version": "1.0.0", "distributions": [], "full_