{"name": "bioconductor-regionereloaded", "id": "6369b3b7cb9912b2145e0e35", "package_types": ["conda"], "summary": "RegioneReloaded: Multiple Association for Genomic Region Sets", "description": "RegioneReloaded is a package that allows simultaneous analysis of associations between genomic region sets, enabling clustering of data and the creation of ready-to-publish graphs. It takes over and expands on all the features of its predecessor regioneR. It also incorporates a strategy to improve p-value calculations and normalize z-scores coming from multiple analysis to allow for their direct comparison. RegioneReloaded builds upon regioneR by adding new plotting functions for obtaining publication-ready graphs.", "home": "https://bioconductor.org/packages/3.16/bioc/html/regioneReloaded.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-regionereloaded", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-regionereloaded", "html_url": "http://anaconda.org/bioconda/bioconductor-regionereloaded", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 4428, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-regionereloaded/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-regionereloaded/1.2.0"}, {"version": "1.4.