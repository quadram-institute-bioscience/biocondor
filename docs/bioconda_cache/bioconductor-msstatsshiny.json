{"name": "bioconductor-msstatsshiny", "id": "63687870bdd024375c0f1b0c", "package_types": ["conda"], "summary": "MSstats GUI for Statistical Anaylsis of Proteomics Experiments", "description": "MSstatsShiny is an R-Shiny graphical user interface (GUI) integrated with the R packages MSstats, MSstatsTMT, and MSstatsPTM. It provides a point and click end-to-end analysis pipeline applicable to a wide variety of experimental designs. These include data-dependedent acquisitions (DDA) which are label-free or tandem mass tag (TMT)-based, as well as DIA, SRM, and PRM acquisitions and those targeting post-translational modifications (PTMs). The application automatically saves users selections and builds an R script that recreates their analysis, supporting reproducible data analysis.", "home": "https://bioconductor.org/packages/3.16/bioc/html/MSstatsShiny.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-msstatsshiny", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-msstatsshiny", "html_url": "http://anaconda.org/bioconda/bioconductor-msstatsshiny", "versions": ["1.0.0", "1.2.3", "1.4.1"], "latest_version": "1.4.1", "platforms": {"noarch": "1.4.1"}, "conda_platforms": ["noarch"], "revision": 6, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 3215, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-msstatsshiny/1.0.0"}, {"version": "1.2.3", "distributions": [], "full_name": "bioconda/bioconductor-msstatsshiny/1.