{"name": "bioconductor-voyager", "id": "6367c4bebc29e050d53a1583", "package_types": ["conda"], "summary": "From geospatial to spatial omics", "description": "SpatialFeatureExperiment (SFE) is a new S4 class for working with spatial single-cell genomics data. The voyager package implements basic exploratory spatial data analysis (ESDA) methods for SFE. Univariate methods include univariate global spatial ESDA methods such as Moran's I, permutation testing for Moran's I, and correlograms. Bivariate methods include Lee's L and cross variogram. Multivariate methods include MULTISPATI PCA and multivariate local Geary's C recently developed by Anselin. The Voyager package also implements plotting functions to plot SFE data and ESDA results.", "home": "https://bioconductor.org/packages/3.16/bioc/html/Voyager.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-voyager", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-voyager", "html_url": "http://anaconda.org/bioconda/bioconductor-voyager", "versions": ["1.0.3", "1.2.3", "1.4.0", "1.8.1"], "latest_version": "1.8.1", "platforms": {"noarch": "1.8.1"}, "conda_platforms": ["noarch"], "revision": 9, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 4482, "releases": [{"version": "1.0.3", "distributions": [], "full_name": "bioconda/bioconductor-voyager/1.0.3"}, {"version": "1.2.3", "distributions": [], "full_name": "bioconda/bioconductor-voyager/1.2.3"}, {"version": "1.4.0", "distributions"