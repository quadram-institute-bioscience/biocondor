{"name": "pod5", "id": "66e0454176ff84b4bc5724b5", "package_types": ["conda"], "summary": "Oxford Nanopore Technologies Pod5 File Format Python API and Tools.", "description": "POD5 File Format ----------------\nPOD5 is a file format for storing nanopore dna data in an easily accessible way. The format is able to be written in a streaming manner which allows a sequencing instrument to directly write the format.\nData in POD5 is stored using Apache Arrow, allowing users to consume data in many languages using standard tools.\nWhat does this project contain ------------------------------\nThis project contains a core library for reading and writing POD5 data, and a toolkit for accessing this data in other languages.\nDocumentation -------------\nFull documentation is found at https://pod5-file-format.readthedocs.io", "home": "https://github.com/nanoporetech/pod5-file-format", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/pod5", "url": "http://api.anaconda.org/packages/bioconda/pod5", "html_url": "http://anaconda.org/bioconda/pod5", "versions": ["0.3.15", "0.3.27", "0.3.33", "0.3.23"], "latest_version": "0.3.33", "platforms": {"noarch": "0.3.33"}, "conda_platforms": ["noarch"], "revision": 11, "license": "MPL-2.0", "license_url": null, "dev_url": "https://github.com/nanoporetech/pod5-file-format", "doc_url": "https://pod5-file-format.readthedocs.io/en/latest", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 2479, "releases": [{"version": "0.3.15", "distributions": [], "full_name": "bioconda/pod5/0.3.15"}, {"version": "0.3.27", "distributions": [], "full_name": "bioconda/