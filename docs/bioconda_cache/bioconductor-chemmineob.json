{"name": "bioconductor-chemmineob", "id": "636e4eb5ead2dcc8c2669184", "package_types": ["conda"], "summary": "R interface to a subset of OpenBabel functionalities", "description": "ChemmineOB provides an R interface to a subset of cheminformatics functionalities implemented by the OpelBabel C++ project. OpenBabel is an open source cheminformatics toolbox that includes utilities for structure format interconversions, descriptor calculations, compound similarity searching and more. ChemineOB aims to make a subset of these utilities available from within R. For non-developers, ChemineOB is primarily intended to be used from ChemmineR as an add-on package rather than used directly.", "home": "https://bioconductor.org/packages/3.16/bioc/html/ChemmineOB.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-chemmineob", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-chemmineob", "html_url": "http://anaconda.org/bioconda/bioconductor-chemmineob", "versions": ["1.36.0", "1.38.0", "1.40.0"], "latest_version": "1.40.0", "platforms": {"linux-64": "1.40.0", "osx-64": "1.40.0"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 6, "license": "file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hb890f52_0", "r43hc247a5b_0", "r42hc247a5b_1", "r42hb890f52_0", "r42hc0ef7c4_1", "r42hc247a5b_0"], "ndownloads": 5348, "releases": [{"version": "1.36.0", "distributions": [], "full_name": "bioconda/bioconductor-chemmineob/1.36.0"}, {"version": "1.38.0", "distributions": [], "full_name": "bioconda/bioconductor-chemmineob/1