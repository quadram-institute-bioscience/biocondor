{"name": "bioconductor-hpip", "id": "61801e285a1e30bf3fbb8485", "package_types": ["conda"], "summary": "Host-Pathogen Interaction Prediction", "description": "HPiP (Host-Pathogen Interaction Prediction) uses an ensemble learning algorithm for prediction of host-pathogen protein-protein interactions (HP-PPIs) using structural and physicochemical descriptors computed from amino acid-composition of host and pathogen proteins.The proposed package can effectively address data shortages and data unavailability for HP-PPI network reconstructions. Moreover, establishing computational frameworks in that regard will reveal mechanistic insights into infectious diseases and suggest potential HP-PPI targets, thus narrowing down the range of possible candidates for subsequent wet-lab experimental validations.", "home": "https://bioconductor.org/packages/3.14/bioc/html/HPiP.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-hpip", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-hpip", "html_url": "http://anaconda.org/bioconda/bioconductor-hpip", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_1"], "ndownloads": 8012, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-hpip/1.0.0"}, {"version": "1.4.0", "distribut