{"name": "usalign", "id": "66e3bf6c968d618564a149f1", "package_types": ["conda"], "summary": "Universal structure alignment of monomeric, complex proteins and nucleic acids", "description": "US-align (Universal Structural alignment) is a unified protocol\nto compare 3D structures of different macromolecules (proteins, RNAs and DNAs)\nin different forms (monomers, oligomers and heterocomplexes)\nfor both pairwise and multiple structure alignments.\nThe core alogrithm of US-align is extended from TM-align and generates optimal structural alignments\nby maximizing TM-score of compared strucures through heuristic dynamic programming iterations.\nLarge-scale benchmark tests showed that US-align can generate more accurate structural alignments\nwith significantly reduced CPU time, compared to the state-of-the-art methods developed\nfor specific structural alignment tasks.\nTM-score has values in (0,1] with 1 indicating an identical structure match,\nwhere a TM-score \u22650.5 (or 0.45) means the structures share the same global topology for proteins (or RNAs).\n", "home": "https://zhanggroup.org/US-align", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/usalign", "url": "http://api.anaconda.org/packages/bioconda/usalign", "html_url": "http://anaconda.org/bioconda/usalign", "versions": ["2024.07.30", "20241201"], "latest_version": "20241201", "platforms": {"linux-aarch64": "20241201", "linux-64": "20241201", "osx-arm64": "20241201", "osx-64": "20241201"}, "conda_platforms": ["osx-arm64", "linux-64", "linux-aarch64", "osx-64"], "revision": 16, "license": "UNKNOWN", "license_url": null, "dev_url": "https://github.com/pylelab/USalign", "doc_url": "https://zhanggroup.org/U