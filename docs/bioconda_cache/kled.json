{"name": "kled", "id": "68927baf7bb7ffab110a3abe", "package_types": ["conda"], "summary": "An ultra-fast and sensitive structural variant detection tool for long-read sequencing data.", "description": "Kled is designed to call SVs nicely and quickly using long-read sequencing data.\nIt takes mapped reads file (bam) as input and reports SVs to the stdout in the\nVCF file format. Kled can yield precise and comprehensive SV detection results\nwithin minutes and can run on any modern computer without needing of any field\nknowledge of the user to perform the SV detection.\n", "home": "https://github.com/CoREse/kled", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/kled", "url": "http://api.anaconda.org/packages/bioconda/kled", "html_url": "http://anaconda.org/bioconda/kled", "versions": ["1.2.9H11", "1.2.10"], "latest_version": "1.2.10", "platforms": {"linux-64": "1.2.10", "linux-aarch64": "1.2.10"}, "conda_platforms": ["linux-64", "linux-aarch64"], "revision": 8, "license": "MIT", "license_url": null, "dev_url": "https://github.com/CoREse/kled", "doc_url": "https://github.com/CoREse/kled/blob/v1.2.9H11/README.md", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h4f462e4_0", "hd9a78ff_0"], "ndownloads": 599, "releases": [{"version": "1.2.9H11", "distributions": [], "full_name": "bioconda/kled/1.2.9H11"}, {"version": "1.2.10", "distributions": [], "full_name": "bioconda/kled/1.2.10"}], "watchers": 1, "upvoted": 0, "created_at": "2025-08-05 21:46:23.210000+00:00", "modified_at": "2025-08-08 15:02:30.375000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "