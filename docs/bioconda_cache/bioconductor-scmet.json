{"name": "bioconductor-scmet", "id": "63679351bc29e050d522f122", "package_types": ["conda"], "summary": "Bayesian modelling of cell-to-cell DNA methylation heterogeneity", "description": "High-throughput single-cell measurements of DNA methylomes can quantify methylation heterogeneity and uncover its role in gene regulation. However, technical limitations and sparse coverage can preclude this task. scMET is a hierarchical Bayesian model which overcomes sparsity, sharing information across cells and genomic features to robustly quantify genuine biological heterogeneity. scMET can identify highly variable features that drive epigenetic heterogeneity, and perform differential methylation and variability analyses. We illustrate how scMET facilitates the characterization of epigenetically distinct cell populations and how it enables the formulation of novel hypotheses on the epigenetic regulation of gene expression.", "home": "https://bioconductor.org/packages/3.16/bioc/html/scMET.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-scmet", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-scmet", "html_url": "http://anaconda.org/bioconda/bioconductor-scmet", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"linux-64": "1.8.0", "osx-64": "1.8.0", "linux-aarch64": "1.8.0", "osx-arm64": "1.12.0"}, "conda_platforms": ["osx-arm64", "linux-64", "linux-aarch64", "osx-64"], "revision": 17, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r45h97584a2_0", "r42h