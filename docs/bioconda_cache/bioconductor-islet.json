{"name": "bioconductor-islet", "id": "63671dd1ead2dcc8c26a9d68", "package_types": ["conda"], "summary": "Individual-Specific ceLl typE referencing Tool", "description": "ISLET is a method to conduct signal deconvolution for general -omics data. It can estimate the individual-specific and cell-type-specific reference panels, when there are multiple samples observed from each subject. It takes the input of the observed mixture data (feature by sample matrix), and the cell type mixture proportions (sample by cell type matrix), and the sample-to-subject information. It can solve for the reference panel on the individual-basis and conduct test to identify cell-type-specific differential expression (csDE) genes. It also improves estimated cell type mixture proportions by integrating personalized reference panels.", "home": "https://bioconductor.org/packages/3.16/bioc/html/ISLET.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-islet", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-islet", "html_url": "http://anaconda.org/bioconda/bioconductor-islet", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "GPL-2", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 5126, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-islet/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconduc