{"name": "recmpox", "id": "698fc7401734e38e616e8c92", "package_types": ["conda"], "summary": "RecMpox flags potential recombination events in monkeypox consensus genomes.", "description": "RecMpox is a command-line tool that flags potential recombination events in monkeypox viruses.\nIt identifies recombination tract breakpoints within your own provided consensus genomes.\nIt does not confirm recombination; it flags genomes that may be recombinant for further investigation.\nRecMpox takes two references (e.g. Clade Ia vs Ib, or IIa vs IIb), aligns them with Squirrel,\nfinds diagnostic SNP positions where the references differ, then classifies each consensus genome\nat those positions. Genomes where both refs contribute at least 5% are flagged as potential\nrecombinants. Recombination tracts and breakpoints are inferred along the genome.\n", "home": "https://github.com/DaanJansen94/RecMpox", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/recmpox", "url": "http://api.anaconda.org/packages/bioconda/recmpox", "html_url": "http://anaconda.org/bioconda/recmpox", "versions": ["0.0.1", "0.0.2"], "latest_version": "0.0.2", "platforms": {"noarch": "0.0.2"}, "conda_platforms": ["noarch"], "revision": 6, "license": "GPL-3.0-or-later", "license_url": null, "dev_url": "https://github.com/DaanJansen94/RecMpox", "doc_url": "https://github.com/DaanJansen94/RecMpox/blob/main/README.md", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 44, "releases": [{"version": "0.0.1", "distributions": [], "full_name": "bioconda/recmpox/0.0.1"}, {"version": "0.0.2", "distributions": [], "full_name": "