{"name": "bioconductor-harmonizr", "id": "6585a6410851d7ac0e193cc1", "package_types": ["conda"], "summary": "Handles missing values and makes more data available", "description": "An implementation, which takes input data and makes it available for proper batch effect removal by ComBat or Limma. The implementation appropriately handles missing values by dissecting the input matrix into smaller matrices with sufficient data to feed the ComBat or limma algorithm. The adjusted data is returned to the user as a rebuild matrix. The implementation is meant to make as much data available as possible with minimal data loss.", "home": "https://bioconductor.org/packages/3.18/bioc/html/HarmonizR.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-harmonizr", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-harmonizr", "html_url": "http://anaconda.org/bioconda/bioconductor-harmonizr", "versions": ["1.0.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 1668, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-harmonizr/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-harmonizr/1.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-22 15:07:45.508000+00:00", "modified_at": "2025-04-22 15:29:39.948000+00:00", "files": [{"description": null, "dependencies": ["depend