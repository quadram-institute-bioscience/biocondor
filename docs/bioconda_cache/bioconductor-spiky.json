{"name": "bioconductor-spiky", "id": "61885256c16f55df02640944", "package_types": ["conda"], "summary": "Spike-in calibration for cell-free MeDIP", "description": "spiky implements methods and model generation for cfMeDIP (cell-free methylated DNA immunoprecipitation) with spike-in controls. CfMeDIP is an enrichment protocol which avoids destructive conversion of scarce template, making it ideal as a \"liquid biopsy,\" but creating certain challenges in comparing results across specimens, subjects, and experiments. The use of synthetic spike-in standard oligos allows diagnostics performed with cfMeDIP to quantitatively compare samples across subjects, experiments, and time points in both relative and absolute terms.", "home": "https://bioconductor.org/packages/3.14/bioc/html/spiky.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-spiky", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-spiky", "html_url": "http://anaconda.org/bioconda/bioconductor-spiky", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "GPL-2", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 7718, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-spiky/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-spiky/1.4.0"}, {"version": "1.6.0", "distributions": [], "f