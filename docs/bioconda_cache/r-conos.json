{"name": "r-conos", "id": "6287e6f127bdd9a91c21b345", "package_types": ["conda"], "summary": "Wires together large collections of single-cell RNA-seq datasets, which allows for both the identification of recurrent cell clusters and the propagation of information between datasets in multi-sample or atlas-scale collections. 'Conos' focuses on the uniform mapping of homologous cell types across heterogeneous sample collections. For instance, users could investigate a collection of dozens of peripheral blood samples from cancer patients combined with dozens of controls, which perhaps includes samples of a related tissue such as lymph nodes. This package interacts with data available through the 'conosPanel' package, which is available in a 'drat' repository. To access this data package, see the instructions at <https://github.com/kharchenkolab/conos>. The size of the 'conosPanel' package is approximately 12 MB.", "description": "", "home": "https://github.com/kharchenkolab/conos", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-conos", "url": "http://api.anaconda.org/packages/bioconda/r-conos", "html_url": "http://anaconda.org/bioconda/r-conos", "versions": ["1.4.6", "1.4.7", "1.4.8", "1.4.9", "1.5.0", "1.5.1", "1.5.2"], "latest_version": "1.5.2", "platforms": {"linux-64": "1.5.2", "osx-64": "1.5.2"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 19, "license": "GPL-3.0-only", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43h71b3455_0", "r42h21a89ab_2", "r42h71b3455_2", "r41h4277420_0", "r41hecf12ef_0", "r43h71b3455_3", "r42h63d8054_1"