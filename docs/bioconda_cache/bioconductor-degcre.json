{"name": "bioconductor-degcre", "id": "67748f6cfaa259e8d390c271", "package_types": ["conda"], "summary": "Probabilistic association of DEGs to CREs from differential data", "description": "DegCre generates associations between differentially expressed genes (DEGs) and cis-regulatory elements (CREs) based on non-parametric concordance between differential data. The user provides GRanges of DEG TSS and CRE regions with differential p-value and optionally log-fold changes and DegCre returns an annotated Hits object with associations and their calculated probabilities. Additionally, the package provides functionality for visualization and conversion to other formats.", "home": "https://bioconductor.org/packages/3.20/bioc/html/DegCre.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-degcre", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-degcre", "html_url": "http://anaconda.org/bioconda/bioconductor-degcre", "versions": ["1.2.0"], "latest_version": "1.2.0", "platforms": {"noarch": "1.2.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 426, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-degcre/1.2.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-01-01 00:42:20.454000+00:00", "modified_at": "2025-04-22 15:29:44.192000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/bioconductor-degcre-1.2