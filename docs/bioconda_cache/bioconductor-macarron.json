{"name": "bioconductor-macarron", "id": "636e0778bdd024375cc6f141", "package_types": ["conda"], "summary": "Prioritization of potentially bioactive metabolic features from epidemiological and environmental metabolomics datasets", "description": "Macarron is a workflow for the prioritization of potentially bioactive metabolites from metabolomics experiments. Prioritization integrates strengths of evidences of bioactivity such as covariation with a known metabolite, abundance relative to a known metabolite and association with an environmental or phenotypic indicator of bioactivity. Broadly, the workflow consists of stratified clustering of metabolic spectral features which co-vary in abundance in a condition, transfer of functional annotations, estimation of relative abundance and differential abundance analysis to identify associations between features and phenotype/condition.", "home": "https://bioconductor.org/packages/3.16/bioc/html/Macarron.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-macarron", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-macarron", "html_url": "http://anaconda.org/bioconda/bioconductor-macarron", "versions": ["1.2.0", "1.4.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 6, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 4677, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-macarron/1.2.0"}, {