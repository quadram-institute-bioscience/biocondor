{"name": "vgp-processcuration", "id": "69444e4ac8b090581e527a9a", "package_types": ["conda"], "summary": "ProcessCurated - Toolkit for processing manually curated genome assemblies", "description": "ProcessCurated is a toolkit for processing manually curated genome assemblies.\nIt reconciles AGP files manually curated in PretextView to rename, reorient,\nand sort assemblies in preparation for submission. The tool performs three main\noperations: correcting and splitting AGP files while assigning unlocalized sequences,\nassigning chromosome names to scaffolds, and reorienting and renaming sequences\nbased on MashMap alignment data.\n", "home": "https://github.com/vgl-hub/vgl-curation", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/vgp-processcuration", "url": "http://api.anaconda.org/packages/bioconda/vgp-processcuration", "html_url": "http://anaconda.org/bioconda/vgp-processcuration", "versions": ["1.0", "1.1"], "latest_version": "1.1", "platforms": {"noarch": "1.1"}, "conda_platforms": ["noarch"], "revision": 6, "license": "MIT", "license_url": null, "dev_url": "https://github.com/vgl-hub/vgl-curation", "doc_url": "https://github.com/vgl-hub/vgl-curation/blob/postcuration_1.0/README.md", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 61, "releases": [{"version": "1.0", "distributions": [], "full_name": "bioconda/vgp-processcuration/1.0"}, {"version": "1.1", "distributions": [], "full_name": "bioconda/vgp-processcuration/1.1"}], "watchers": 1, "upvoted": 0, "created_at": "2025-12-18 18:56:10.528000+00:00", "modified_at": "2026-01-24 15:23:51.796000+00:00", "files": [