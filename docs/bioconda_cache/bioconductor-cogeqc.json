{"name": "bioconductor-cogeqc", "id": "636802f71f9cf5f92ab8925a", "package_types": ["conda"], "summary": "Systematic quality checks on comparative genomics analyses", "description": "cogeqc aims to facilitate systematic quality checks on standard comparative genomics analyses to help researchers detect issues and select the most suitable parameters for each data set. cogeqc can be used to asses: i. genome assembly and annotation quality with BUSCOs and comparisons of statistics with publicly available genomes on the NCBI; ii. orthogroup inference using a protein domain-based approach and; iii. synteny detection using synteny network properties. There are also data visualization functions to explore QC summary statistics.", "home": "https://bioconductor.org/packages/3.16/bioc/html/cogeqc.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cogeqc", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cogeqc", "html_url": "http://anaconda.org/bioconda/bioconductor-cogeqc", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42hdfd78af_0", "r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 4972, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-cogeqc/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-cogeqc/1.4.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioc