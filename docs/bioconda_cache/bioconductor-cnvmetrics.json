{"name": "bioconductor-cnvmetrics", "id": "6366868846f81babca25bd76", "package_types": ["conda"], "summary": "Copy Number Variant Metrics", "description": "The CNVMetrics package calculates similarity metrics to facilitate copy number variant comparison among samples and/or methods. Similarity metrics can be employed to compare CNV profiles of genetically unrelated samples as well as those with a common genetic background. Some metrics are based on the shared amplified/deleted regions while other metrics rely on the level of amplification/deletion. The data type used as input is a plain text file containing the genomic position of the copy number variations, as well as the status and/or the log2 ratio values. Finally, a visualization tool is provided to explore resulting metrics.", "home": "https://bioconductor.org/packages/3.16/bioc/html/CNVMetrics.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cnvmetrics", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cnvmetrics", "html_url": "http://anaconda.org/bioconda/bioconductor-cnvmetrics", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 4850, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-cnvmetrics/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bi