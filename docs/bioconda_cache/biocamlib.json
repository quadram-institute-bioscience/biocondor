{"name": "biocamlib", "id": "65f37d936cd1a7c629f6a472", "package_types": ["conda"], "summary": "An OCaml foundation upon which a number of the bioinformatics tools are built.", "description": "BiOCamLib is an OCaml foundation upon which a number of the bioinformatics tools are built,\nincluding KPop <https://github.com/PaoloRibeca/KPop>. It consists of four tools:\n1. RC, which can efficiently compute the reverse complement of sequences.\n2. Octopus, which is a high-throughput program to compute the transitive closure of strings.\n3. Parallel, which allows the splits and processes an input file chunk-wise using a reader/workers/writer model.\n4. FASTools, which is a Swiss-knife tool for the manipulation of FASTA/FASTQ files.\n", "home": "https://github.com/PaoloRibeca/BiOCamLib", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/biocamlib", "url": "http://api.anaconda.org/packages/bioconda/biocamlib", "html_url": "http://anaconda.org/bioconda/biocamlib", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"linux-64": "1.0.0", "osx-64": "1.0.0"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 4, "license": "GPL-3.0-only", "license_url": null, "dev_url": "https://github.com/PaoloRibeca/BiOCamLib", "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h527b516_0", "h9ee0642_0"], "ndownloads": 1126, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/biocamlib/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2024-03-14 22:43:31.957000+00:00", "modified_at": "2025-04-22 15:29:40.969000+00:00", "files": [{"description": null, "dependencies": ["de