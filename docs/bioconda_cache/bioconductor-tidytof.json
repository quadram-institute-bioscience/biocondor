{"name": "bioconductor-tidytof", "id": "67632ffc855eb5df2515caa4", "package_types": ["conda"], "summary": "Analyze High-dimensional Cytometry Data Using Tidy Data Principles", "description": "This package implements an interactive, scientific analysis pipeline for high-dimensional cytometry data built using tidy data principles. It is specifically designed to play well with both the tidyverse and Bioconductor software ecosystems, with functionality for reading/writing data files, data cleaning, preprocessing, clustering, visualization, modeling, and other quality-of-life functions. tidytof implements a \"grammar\" of high-dimensional cytometry data analysis.", "home": "https://bioconductor.org/packages/3.20/bioc/html/tidytof.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-tidytof", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-tidytof", "html_url": "http://anaconda.org/bioconda/bioconductor-tidytof", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"linux-64": "1.0.0", "osx-64": "1.0.0"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 4, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44he5774e6_0", "r44h35d7169_0"], "ndownloads": 565, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-tidytof/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2024-12-18 20:26:36.334000+00:00", "modified_at": "2025-04-22 15:29:43.745000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "c