{"name": "bioconductor-cfdnakit", "id": "65736fde5bb8a950010795d3", "package_types": ["conda"], "summary": "Fragmen-length analysis package from high-throughput sequencing of cell-free DNA (cfDNA)", "description": "This package provides basic functions for analyzing shallow whole-genome sequencing (~0.3X or more) of cell-free DNA (cfDNA). The package basically extracts the length of cfDNA fragments and aids the vistualization of fragment-length information. The package also extract fragment-length information per non-overlapping fixed-sized bins and used it for calculating ctDNA estimation score (CES).", "home": "https://bioconductor.org/packages/3.18/bioc/html/cfdnakit.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cfdnakit", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cfdnakit", "html_url": "http://anaconda.org/bioconda/bioconductor-cfdnakit", "versions": ["1.0.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 1426, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-cfdnakit/1.0.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-cfdnakit/1.4.0"}], "watchers": 1, "upvoted": 0, "created_at": "2023-12-08 19:34:54.911000+00:00", "modified_at": "2025-04-22 15:29:39.613000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_t