{"name": "r-proteus-bartongroup", "id": "645b800727b104c733fb491a", "package_types": ["conda"], "summary": "R package for analysing proteomics data", "description": "Proteus is an R package for downstream analysis of MaxQuant output.\nThe input for Proteus is the evidence file. Evidence data are aggregated\ninto peptides and then into proteins. Proteus offers many visualisation\nand data analysis tools both at peptide and protein level. In particular\nit allows simple differential expression using limma.\n", "home": "https://github.com/bartongroup/Proteus", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-proteus-bartongroup", "url": "http://api.anaconda.org/packages/bioconda/r-proteus-bartongroup", "html_url": "http://anaconda.org/bioconda/r-proteus-bartongroup", "versions": ["0.2.16"], "latest_version": "0.2.16", "platforms": {"noarch": "0.2.16"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_2", "r42hdfd78af_0", "r43hdfd78af_1"], "ndownloads": 1715, "releases": [{"version": "0.2.16", "distributions": [], "full_name": "bioconda/r-proteus-bartongroup/0.2.16"}], "watchers": 1, "upvoted": 0, "created_at": "2023-05-10 11:29:11.138000+00:00", "modified_at": "2025-04-22 15:29:36.697000+00:00", "files": [{"description": null, "dependencies": [], "distribution_type": "conda", "basename": "noarch/r-proteus-bartongroup-0.2.16-r42hdfd78af_0.tar.bz2", "attrs": {"build_number": 0, "license": "MIT", "has_prefix": false, "license_family": "MIT", "noarch": "generic", "machine": nul