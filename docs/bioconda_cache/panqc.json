{"name": "panqc", "id": "698cdd3744c4600d051d28fe", "package_types": ["conda"], "summary": "A toolkit for quality control & adjustment of nucleotide redundancy in bacterial pan-genome analyses\n", "description": "panqc is a pan-genome quality control toolkit that evaluates and corrects\nfor nucleotide redundancy in pan-genome analyses. The panqc Nucleotide\nRedundancy Correction (NRC) pipeline adjusts for redundancy at the DNA\nlevel within pan-genome estimates by comparing genes classified as absent\nat the amino acid level against their corresponding assemblies at the\nnucleotide level and by clustering genes using k-mer based nucleotide\nsimilarity metrics.\n", "home": "https://github.com/maxgmarin/panqc", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/panqc", "url": "http://api.anaconda.org/packages/bioconda/panqc", "html_url": "http://anaconda.org/bioconda/panqc", "versions": ["0.0.4"], "latest_version": "0.0.4", "platforms": {"noarch": "0.0.4"}, "conda_platforms": ["noarch"], "revision": 3, "license": "MIT", "license_url": null, "dev_url": "https://github.com/maxgmarin/panqc", "doc_url": "https://github.com/maxgmarin/panqc", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyh106432d_0"], "ndownloads": 20, "releases": [{"version": "0.0.4", "distributions": [], "full_name": "bioconda/panqc/0.0.4"}], "watchers": 1, "upvoted": 0, "created_at": "2026-02-11 19:49:11.398000+00:00", "modified_at": "2026-02-11 19:49:12.508000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/panqc-0.0.4-pyh106432d_0.conda", "attrs": {"operatingsystem