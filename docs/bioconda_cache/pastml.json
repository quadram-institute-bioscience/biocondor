{"name": "pastml", "id": "63041d2dc954963b861d35e2", "package_types": ["conda"], "summary": "Ancestral character reconstruction and visualisation for rooted phylogenetic trees.", "description": "PastML provides fast methods for Ancestral Character Reconstruction (ACR)\nand visualisation on rooted phylogenetic trees. Given a rooted tree and its\nnode annotations, it can either visualise them as-is, or infer ancestral\nnode states based on the tip states, with a selection of maximum likelihood\nand parsimonious methods. The result is then visualised as a zoomable html\nmap.\n", "home": "https://pastml.pasteur.fr", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/pastml", "url": "http://api.anaconda.org/packages/bioconda/pastml", "html_url": "http://anaconda.org/bioconda/pastml", "versions": ["1.9.39", "1.9.40", "1.9.43", "1.9.45", "1.9.46", "1.9.48", "1.9.49", "1.9.50", "1.9.51"], "latest_version": "1.9.51", "platforms": {"noarch": "1.9.51"}, "conda_platforms": ["noarch"], "revision": 25, "license": "GPL-3.0-or-later", "license_url": null, "dev_url": "https://github.com/evolbioinfo/pastml", "doc_url": "https://pastml.pasteur.fr/help", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 12396, "releases": [{"version": "1.9.39", "distributions": [], "full_name": "bioconda/pastml/1.9.39"}, {"version": "1.9.40", "distributions": [], "full_name": "bioconda/pastml/1.9.40"}, {"version": "1.9.43", "distributions": [], "full_name": "bioconda/pastml/1.9.43"}, {"version": "1.9.45", "distributions": [], "full_name": "bioconda/pastml/1.9.45"}, {"version": "1.9.46", "distributions": [], "fu