{"name": "bioconductor-spiat", "id": "63677d671f9cf5f92a844527", "package_types": ["conda"], "summary": "Spatial Image Analysis of Tissues", "description": "SPIAT (**Sp**atial **I**mage **A**nalysis of **T**issues) is an R package with a suite of data processing, quality control, visualization and data analysis tools. SPIAT is compatible with data generated from single-cell spatial proteomics platforms (e.g. OPAL, CODEX, MIBI, cellprofiler). SPIAT reads spatial data in the form of X and Y coordinates of cells, marker intensities and cell phenotypes. SPIAT includes six analysis modules that allow visualization, calculation of cell colocalization, categorization of the immune microenvironment relative to tumor areas, analysis of cellular neighborhoods, and the quantification of spatial heterogeneity, providing a comprehensive toolkit for spatial data analysis.", "home": "https://bioconductor.org/packages/3.16/bioc/html/SPIAT.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-spiat", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-spiat", "html_url": "http://anaconda.org/bioconda/bioconductor-spiat", "versions": ["1.0.0", "1.2.2", "1.4.1", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "Artistic-2.0 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 5233, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-spiat/1.0.0"}, 