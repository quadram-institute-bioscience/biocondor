{"name": "netmd", "id": "6878443110c075e5ec4ddfb1", "package_types": ["conda"], "summary": "NetMD is a computational method for identifying consensus behavior across multiple molecular dynamics simulations.", "description": "Using Graph-based Embeddings and Dynamic Time Warping, *NetMD* aligns trajectories that may be temporally out of sync and\npinpoints the replicas that most faithfully represent the overall ensemble behavior. This enables consistent comparisons across simulations\nand supports reliable characterization of system variants, making it easier to detect shared patterns and reduce the influence of outliers\nor simulation artifacts.\n", "home": "https://github.com/mazzalab/NetMD", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/netmd", "url": "http://api.anaconda.org/packages/bioconda/netmd", "html_url": "http://anaconda.org/bioconda/netmd", "versions": ["1.0.0", "1.0.1", "1.0.2", "1.0.3"], "latest_version": "1.0.3", "platforms": {"noarch": "1.0.3"}, "conda_platforms": ["noarch"], "revision": 12, "license": "MIT", "license_url": null, "dev_url": "https://github.com/mazzalab/NetMD", "doc_url": "https://github.com/mazzalab/NetMD", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyh3c853c9_0"], "ndownloads": 281, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/netmd/1.0.0"}, {"version": "1.0.1", "distributions": [], "full_name": "bioconda/netmd/1.0.1"}, {"version": "1.0.2", "distributions": [], "full_name": "bioconda/netmd/1.0.2"}, {"version": "1.0.3", "distributions": [], "full_name": "bioconda/netmd/1.0.3"}], "watchers": 1, "upvoted": 0, "created_at": "2025-