{"name": "fiji-max_inscribed_circles", "id": "62fe367c8914a6faaf4bdc0c", "package_types": ["conda"], "summary": "ImageJ / Fiji plugin implementing an iterative Largest Inscribed Circle algorithm using a euclidean distance map", "description": "ImageJ / Fiji plugin implementing an iterative Largest Inscribed Circle algorithm\nwhich runs over a binary image or selection in order to fit the maximum number\nof non-touching circles down to a minimum diameter.\nThe approach uses a Euclidean Distance Map in order to find candidate circles\nfrom the largest to the smallest.\nThe code is written for Java 8,\nwhich is the currently supported Java version for Fiji and ImageJ.\n", "home": "https://imagej.net/plugins/max-inscribed-circles", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/fiji-max_inscribed_circles", "url": "http://api.anaconda.org/packages/bioconda/fiji-max_inscribed_circles", "html_url": "http://anaconda.org/bioconda/fiji-max_inscribed_circles", "versions": ["1.1.2", "2.0.0", "2.1.0"], "latest_version": "2.1.0", "platforms": {"noarch": "2.1.0"}, "conda_platforms": ["noarch"], "revision": 6, "license": "GPLv3", "license_url": null, "dev_url": "https://github.com/BIOP/ijp-max-inscribed-circles", "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["hdfd78af_0"], "ndownloads": 4822, "releases": [{"version": "1.1.2", "distributions": [], "full_name": "bioconda/fiji-max_inscribed_circles/1.1.2"}, {"version": "2.0.0", "distributions": [], "full_name": "bioconda/fiji-max_inscribed_circles/2.0.0"}, {"version": "2.1.0", "distributions": [], "full_name": "bioconda/fiji-max_inscribed_circles/2.