{"name": "bioconductor-sparsearray", "id": "64ac40923497791861bf4a3d", "package_types": ["conda"], "summary": "High-performance sparse data representation and manipulation in R", "description": "The SparseArray package provides array-like containers for efficient in-memory representation of multidimensional sparse data in R (arrays and matrices). The package defines the SparseArray virtual class and two concrete subclasses: COO_SparseArray and SVT_SparseArray. Each subclass uses its own internal representation of the nonzero multidimensional data: the \"COO layout\" and the \"SVT layout\", respectively. SVT_SparseArray objects mimic as much as possible the behavior of ordinary matrix and array objects in base R. In particular, they suppport most of the \"standard matrix and array API\" defined in base R and in the matrixStats package from CRAN.", "home": "https://bioconductor.org/packages/3.17/bioc/html/SparseArray.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-sparsearray", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-sparsearray", "html_url": "http://anaconda.org/bioconda/bioconductor-sparsearray", "versions": ["1.0.10", "1.2.2", "1.6.0", "1.10.8"], "latest_version": "1.10.8", "platforms": {"linux-64": "1.6.0", "osx-64": "1.6.0", "linux-aarch64": "1.10.8", "osx-arm64": "1.10.8"}, "conda_platforms": ["osx-arm64", "osx-64", "linux-aarch64", "linux-64"], "revision": 21, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43h4c50009_1", "r44h3df3fcb_0", "r44h1b44f6e_0", "r44h59b44dc_0"