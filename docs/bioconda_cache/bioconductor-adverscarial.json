{"name": "bioconductor-adverscarial", "id": "6572e84fd600a7728b420679", "package_types": ["conda"], "summary": "adverSCarial, generate and analyze the vulnerability of scRNA-seq classifier to adversarial attacks", "description": "adverSCarial is an R Package designed for generating and analyzing the vulnerability of scRNA-seq classifiers to adversarial attacks. The package is versatile and provides a format for integrating any type of classifier. It offers functions for studying and generating two types of attacks, single gene attack and max change attack. The single-gene attack involves making a small modification to the input to alter the classification. The max-change attack involves making a large modification to the input without changing its classification. The package provides a comprehensive solution for evaluating the robustness of scRNA-seq classifiers against adversarial attacks.", "home": "https://bioconductor.org/packages/3.18/bioc/html/adverSCarial.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-adverscarial", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-adverscarial", "html_url": "http://anaconda.org/bioconda/bioconductor-adverscarial", "versions": ["1.0.0", "1.4.0"], "latest_version": "1.4.0", "platforms": {"noarch": "1.4.0"}, "conda_platforms": ["noarch"], "revision": 5, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 1668, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconducto