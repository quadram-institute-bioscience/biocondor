{"name": "r-rldne", "id": "693d0f42b649e5787b0fbc4e", "package_types": ["conda"], "summary": "A Convenient R Interface For NeEstimator V2.1", "description": "An R-package that conveniently interfaces with NeEstimator 2.1 (Do et al. 2014). NeEstimator V2.1 executables are distributed with this package freely, for non-commericial, educational purposes only.\nGiven that NeEstimator is quite straightfoward to run, a common use case for this package is when you want to simulate/downsample and run many iterations of the LD-method via R.\nThis package allows the LD-Method in NeEstimator V2.1 to be easily executed via R.\n", "home": "https://github.com/zakrobinson/RLDNe", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-rldne", "url": "http://api.anaconda.org/packages/bioconda/r-rldne", "html_url": "http://anaconda.org/bioconda/r-rldne", "versions": ["1.0.0"], "latest_version": "1.0.0", "platforms": {"noarch": "1.0.0"}, "conda_platforms": ["noarch"], "revision": 4, "license": "GPL-2.0-only", "license_url": null, "dev_url": "https://github.com/zakrobinson/RLDNe", "doc_url": "https://github.com/zakrobinson/RLDNe", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r45hdfd78af_0", "r45hdfd78af_1"], "ndownloads": 72, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/r-rldne/1.0.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-12-13 07:01:22.641000+00:00", "modified_at": "2026-01-06 09:54:31.967000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "noarch/r-rldne-1.0.0-r45hdfd78af_0.conda", "attrs": {"operatingsystem": n