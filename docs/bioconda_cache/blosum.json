{"name": "blosum", "id": "6299c76b86b0cbb13115d7a8", "package_types": ["conda"], "summary": "A small module for easy access to BLOSUM matrices without dependencies.", "description": "The BLOcks SUbstitution Matrices (BLOSUM) are used to score alignments between protein sequences and are therefore mainly used in bioinformatics. Reading such matrices is not particularly difficult, yet most off the shelf packages are overloaded with strange dependencies. And why do we need to implement the same reader again if there is a simple module for that. blosum offers a robust and easy-to-expand implementation without relying on third-party libraries.\n", "home": "https://github.com/not-a-feature/blosum", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/blosum", "url": "http://api.anaconda.org/packages/bioconda/blosum", "html_url": "http://anaconda.org/bioconda/blosum", "versions": ["1.1.3", "1.2.0", "1.2.1", "1.2.2", "2.0.1", "2.0.2", "2.0.3", "2.2.0"], "latest_version": "2.2.0", "platforms": {"noarch": "2.2.0"}, "conda_platforms": ["noarch"], "revision": 18, "license": "GPL-3.0-or-later", "license_url": null, "dev_url": "https://github.com/not-a-feature/blosum", "doc_url": "https://github.com/not-a-feature/blosum", "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["pyhdfd78af_0"], "ndownloads": 13559, "releases": [{"version": "1.1.3", "distributions": [], "full_name": "bioconda/blosum/1.1.3"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/blosum/1.2.0"}, {"version": "1.2.1", "distributions": [], "full_name": "bioconda/blosum/1.2.1"}, {"version": "1.2.2", "distributions": [], "full_name": "biocon