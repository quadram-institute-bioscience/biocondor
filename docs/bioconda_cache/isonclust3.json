{"name": "isonclust3", "id": "693fe6abc02d2789367cc245", "package_types": ["conda"], "summary": "De novo clustering of long transcript reads into genes", "description": "isONclust3 is a tool for clustering either PacBio Iso-Seq reads, or Oxford Nanopore reads into clusters, where each cluster represents all reads that came from a gene family. Output is a tsv file with each read assigned to a cluster-ID and a folder 'fastq' containing one fastq file per cluster generated. Detailed information is available in the isONclust3 paper https://doi.org/10.1093/bioinformatics/btaf207\n", "home": "https://github.com/aljpetri/isONclust3", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/isonclust3", "url": "http://api.anaconda.org/packages/bioconda/isonclust3", "html_url": "http://anaconda.org/bioconda/isonclust3", "versions": ["0.3.0"], "latest_version": "0.3.0", "platforms": {"linux-64": "0.3.0", "osx-64": "0.3.0"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 4, "license": "GPL-3.0-or-later", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["h4349ce8_0", "h00cbfe0_0"], "ndownloads": 371, "releases": [{"version": "0.3.0", "distributions": [], "full_name": "bioconda/isonclust3/0.3.0"}], "watchers": 1, "upvoted": 0, "created_at": "2025-12-15 10:44:59.080000+00:00", "modified_at": "2025-12-15 10:48:23.751000+00:00", "files": [{"description": null, "dependencies": ["depends"], "distribution_type": "conda", "basename": "linux-64/isonclust3-0.3.0-h4349ce8_0.conda", "attrs": {"operatingsystem": "linux", "machine": "x86_64", "target-triplet": "x86_64-any-l