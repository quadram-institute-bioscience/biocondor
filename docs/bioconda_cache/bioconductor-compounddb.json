{"name": "bioconductor-compounddb", "id": "6366678a46f81babca130499", "package_types": ["conda"], "summary": "Creating and Using (Chemical) Compound Annotation Databases", "description": "CompoundDb provides functionality to create and use (chemical) compound annotation databases from a variety of different sources such as LipidMaps, HMDB, ChEBI or MassBank. The database format allows to store in addition MS/MS spectra along with compound information. The package provides also a backend for Bioconductor's Spectra package and allows thus to match experimetal MS/MS spectra against MS/MS spectra in the database. Databases can be stored in SQLite format and are thus portable.", "home": "https://bioconductor.org/packages/3.16/bioc/html/CompoundDb.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-compounddb", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-compounddb", "html_url": "http://anaconda.org/bioconda/bioconductor-compounddb", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"noarch": "1.10.0"}, "conda_platforms": ["noarch"], "revision": 9, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r43hdfd78af_0", "r42hdfd78af_0"], "ndownloads": 5384, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-compounddb/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-compounddb/1.4.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-c