{"name": "bioconductor-planttfhunter", "id": "64ad8537a02fea6b6ac4bc0d", "package_types": ["conda"], "summary": "Identification and classification of plant transcription factors", "description": "planttfhunter is used to identify plant transcription factors (TFs) from protein sequence data and classify them into families and subfamilies using the classification scheme implemented in PlantTFDB. TFs are identified using pre-built hidden Markov model profiles for DNA-binding domains. Then, auxiliary and forbidden domains are used with DNA-binding domains to classify TFs into families and subfamilies (when applicable). Currently, TFs can be classified in 58 different TF families/subfamilies.", "home": "https://bioconductor.org/packages/3.17/bioc/html/planttfhunter.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-planttfhunter", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-planttfhunter", "html_url": "http://anaconda.org/bioconda/bioconductor-planttfhunter", "versions": ["1.0.0", "1.2.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 7, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hdfd78af_0", "r44hdfd78af_0"], "ndownloads": 3154, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-planttfhunter/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-planttfhunter/1.2.0"}, {"version": "1.6.0", "distributions": [], "full_name": "bioconda/bioconductor-pla