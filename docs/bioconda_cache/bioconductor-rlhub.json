{"name": "bioconductor-rlhub", "id": "618678649501cf2a1d3f9818", "package_types": ["conda"], "summary": "An ExperimentHub package for accessing processed RLSuite data sets", "description": "| RLHub provides a convenient interface to the processed data provided within RLSuite, a tool-chain for analyzing R-loop-mapping data sets. The primary purpose of RLHub is to serve the processed data sets required by the RLSeq R package and the RLBase web service. Additionally, RLHub provides a stand-alone R interface to these data, benefiting users who are addressing questions related to R-loop regions (RL-Regions), R-loop-binding proteins (RLBPs), R-loop co-localizing factors, and the differences between R-loop-mapping methods. The full data-generating protocol is found here: https://github.com/Bishop-Laboratory/RLBase-data.", "home": "https://bioconductor.org/packages/3.14/data/experiment/html/RLHub.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-rlhub", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-rlhub", "html_url": "http://anaconda.org/bioconda/bioconductor-rlhub", "versions": ["1.0.0", "1.4.0", "1.6.0"], "latest_version": "1.6.0", "platforms": {"noarch": "1.6.0"}, "conda_platforms": ["noarch"], "revision": 6, "license": "MIT + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r42hdfd78af_0", "r41hdfd78af_1", "r43hdfd78af_0"], "ndownloads": 6393, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-rlhub/1.0.0"}, {"version": "1.4.0", "distributions"