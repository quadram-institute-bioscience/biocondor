{"name": "bioconductor-asurat", "id": "63679c95ead2dcc8c2872e30", "package_types": ["conda"], "summary": "Functional annotation-driven unsupervised clustering for single-cell data", "description": "ASURAT is a software for single-cell data analysis. Using ASURAT, one can simultaneously perform unsupervised clustering and biological interpretation in terms of cell type, disease, biological process, and signaling pathway activity. Inputting a single-cell RNA-seq data and knowledge-based databases, such as Cell Ontology, Gene Ontology, KEGG, etc., ASURAT transforms gene expression tables into original multivariate tables, termed sign-by-sample matrices (SSMs).", "home": "https://bioconductor.org/packages/3.16/bioc/html/ASURAT.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-asurat", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-asurat", "html_url": "http://anaconda.org/bioconda/bioconductor-asurat", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"linux-64": "1.10.0", "osx-64": "1.10.0"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 10, "license": "GPL-3 + file LICENSE", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hf17093f_1", "r43hc0ef7c4_1", "r43hc0ef7c4_0", "r44h35d7169_0", "r42hc247a5b_0", "r42hf17093f_1", "r44he5774e6_0", "r43hf17093f_0"], "ndownloads": 5764, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-asurat/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-asurat