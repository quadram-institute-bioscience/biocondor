{"name": "bioconductor-microbiomemarker", "id": "6187297a7fc781d3ffd43553", "package_types": ["conda"], "summary": "microbiome biomarker analysis toolkit", "description": "To date, a number of methods have been developed for microbiome marker discovery based on metagenomic profiles, e.g. LEfSe. However, all of these methods have its own advantages and disadvantages, and none of them is considered standard or universal. Moreover, different programs or softwares may be development using different programming languages, even in different operating systems. Here, we have developed an all-in-one R package microbiomeMarker that integrates commonly used differential analysis methods as well as three machine learning-based approaches, including Logistic regression, Random forest, and Support vector machine, to facilitate the identification of microbiome markers.", "home": "https://bioconductor.org/packages/3.14/bioc/html/microbiomeMarker.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-microbiomemarker", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-microbiomemarker", "html_url": "http://anaconda.org/bioconda/bioconductor-microbiomemarker", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"noarch": "1.8.0"}, "conda_platforms": ["noarch"], "revision": 8, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 5939, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconduct