{"name": "bioconductor-cytomem", "id": "6364f22fd4690f7177c517e5", "package_types": ["conda"], "summary": "Marker Enrichment Modeling (MEM)", "description": "MEM, Marker Enrichment Modeling, automatically generates and displays quantitative labels for cell populations that have been identified from single-cell data. The input for MEM is a dataset that has pre-clustered or pre-gated populations with cells in rows and features in columns. Labels convey a list of measured features and the features' levels of relative enrichment on each population. MEM can be applied to a wide variety of data types and can compare between MEM labels from flow cytometry, mass cytometry, single cell RNA-seq, and spectral flow cytometry using RMSD.", "home": "https://bioconductor.org/packages/3.16/bioc/html/cytoMEM.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-cytomem", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-cytomem", "html_url": "http://anaconda.org/bioconda/bioconductor-cytomem", "versions": ["1.2.0", "1.4.0", "1.6.0", "1.10.0", "1.14.0"], "latest_version": "1.14.0", "platforms": {"noarch": "1.14.0"}, "conda_platforms": ["noarch"], "revision": 12, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0", "r45hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 5198, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-cytomem/1.2.0"}, {"version": "1.4.0", "distributions": [], "full_name": "bioconda/bioconductor-cytomem/1.4.0"}, {"version": "1.6.0", "