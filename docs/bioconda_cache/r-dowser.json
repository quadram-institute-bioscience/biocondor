{"name": "r-dowser", "id": "61eb3fc613ef1fb79e278ac6", "package_types": ["conda"], "summary": "Provides a set of functions for inferring, visualizing, and analyzing B cell phylogenetic trees. Provides methods to 1) reconstruct unmutated ancestral sequences, 2) build B cell phylogenetic trees using multiple methods, 3) visualize trees with metadata at the tips, 4) reconstruct intermediate sequences, 5) detect biased ancestor-descendant relationships among metadata types Workflow examples available at documentation site (see URL). Citations: Hoehn et al (2020) <doi:10.1101/2020.05.30.124446>, Hoehn et al (2021) <doi:10.1101/2021.01.06.425648>.", "description": "", "home": "https://dowser.readthedocs.io", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/r-dowser", "url": "http://api.anaconda.org/packages/bioconda/r-dowser", "html_url": "http://anaconda.org/bioconda/r-dowser", "versions": ["0.1.0", "1.0.0", "1.1.0", "1.2.0"], "latest_version": "1.2.0", "platforms": {"noarch": "1.2.0"}, "conda_platforms": ["noarch"], "revision": 8, "license": "AGPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r42h3121a25_1", "r41h3121a25_0", "r42h3121a25_0"], "ndownloads": 8461, "releases": [{"version": "0.1.0", "distributions": [], "full_name": "bioconda/r-dowser/0.1.0"}, {"version": "1.0.0", "distributions": [], "full_name": "bioconda/r-dowser/1.0.0"}, {"version": "1.1.0", "distributions": [], "full_name": "bioconda/r-dowser/1.1.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/r-dowser/1.2.0"}], "watchers": 1, "upvoted": 0, "created_at": 