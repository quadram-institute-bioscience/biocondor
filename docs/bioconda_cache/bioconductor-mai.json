{"name": "bioconductor-mai", "id": "6182d38bcce6a3bb4d484514", "package_types": ["conda"], "summary": "Mechanism-Aware Imputation", "description": "A two-step approach to imputing missing data in metabolomics. Step 1 uses a random forest classifier to classify missing values as either Missing Completely at Random/Missing At Random (MCAR/MAR) or Missing Not At Random (MNAR). MCAR/MAR are combined because it is often difficult to distinguish these two missing types in metabolomics data. Step 2 imputes the missing values based on the classified missing mechanisms, using the appropriate imputation algorithms. Imputation algorithms tested and available for MCAR/MAR include Bayesian Principal Component Analysis (BPCA), Multiple Imputation No-Skip K-Nearest Neighbors (Multi_nsKNN), and Random Forest. Imputation algorithms tested and available for MNAR include nsKNN and a single imputation approach for imputation of metabolites where left-censoring is present.", "home": "https://bioconductor.org/packages/3.14/bioc/html/MAI.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-mai", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-mai", "html_url": "http://anaconda.org/bioconda/bioconductor-mai", "versions": ["1.0.0", "1.4.0", "1.6.0", "1.8.0", "1.12.0"], "latest_version": "1.12.0", "platforms": {"noarch": "1.12.0"}, "conda_platforms": ["noarch"], "revision": 11, "license": "GPL-3", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r41hdfd78af_0", "r44hdfd78af_0", "r42hdfd78af_0", "r43hdfd78af_0"], "ndownloads": 7753, "releases"