{"name": "bioconductor-fusesom", "id": "63670df7c730b52a90c06d4f", "package_types": ["conda"], "summary": "A Correlation Based Multiview Self Organizing Maps Clustering For IMC Datasets", "description": "A correlation-based multiview self-organizing map for the characterization of cell types in highly multiplexed in situ imaging cytometry assays (`FuseSOM`) is a tool for unsupervised clustering. `FuseSOM` is robust and achieves high accuracy by combining a `Self Organizing Map` architecture and a `Multiview` integration of correlation based metrics. This allows FuseSOM to cluster highly multiplexed in situ imaging cytometry assays.", "home": "https://bioconductor.org/packages/3.16/bioc/html/FuseSOM.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-fusesom", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-fusesom", "html_url": "http://anaconda.org/bioconda/bioconductor-fusesom", "versions": ["1.0.0", "1.2.0", "1.4.0", "1.8.0"], "latest_version": "1.8.0", "platforms": {"linux-64": "1.8.0", "osx-64": "1.8.0"}, "conda_platforms": ["osx-64", "linux-64"], "revision": 10, "license": "GPL-2", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44h35d7169_0", "r43hc0ef7c4_0", "r43hf17093f_0", "r42hb890f52_0", "r42hc0ef7c4_1", "r42hf17093f_1", "r44he5774e6_0", "r42hc247a5b_0"], "ndownloads": 5777, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-fusesom/1.0.0"}, {"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-fusesom/1.2.0"}, {"version": "1.4.0", "distrib