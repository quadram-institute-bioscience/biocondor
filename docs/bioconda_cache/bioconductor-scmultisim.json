{"name": "bioconductor-scmultisim", "id": "67668114e538bc3449ea6393", "package_types": ["conda"], "summary": "Simulation of Multi-Modality Single Cell Data Guided By Gene Regulatory Networks and Cell-Cell Interactions", "description": "scMultiSim simulates paired single cell RNA-seq, single cell ATAC-seq and RNA velocity data, while incorporating mechanisms of gene regulatory networks, chromatin accessibility and cell-cell interactions. It allows users to tune various parameters controlling the amount of each biological factor, variation of gene-expression levels, the influence of chromatin accessibility on RNA sequence data, and so on. It can be used to benchmark various computational methods for single cell multi-omics data, and to assist in experimental design of wet-lab experiments.", "home": "https://bioconductor.org/packages/3.20/bioc/html/scMultiSim.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-scmultisim", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-scmultisim", "html_url": "http://anaconda.org/bioconda/bioconductor-scmultisim", "versions": ["1.2.0"], "latest_version": "1.2.0", "platforms": {"noarch": "1.2.0"}, "conda_platforms": ["noarch"], "revision": 3, "license": "Artistic-2.0", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r44hdfd78af_0"], "ndownloads": 308, "releases": [{"version": "1.2.0", "distributions": [], "full_name": "bioconda/bioconductor-scmultisim/1.2.0"}], "watchers": 1, "upvoted": 0, "created_at": "2024-12-21 08:49:24.771000+00:00", "modified_at": "2025-04-22 15:29:43.881000+00