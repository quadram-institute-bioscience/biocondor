{"name": "bioconductor-retrofit", "id": "64a7d271a882a42ef5256093", "package_types": ["conda"], "summary": "RETROFIT: Reference-free deconvolution of cell mixtures in spatial transcriptomics", "description": "RETROFIT is a Bayesian non-negative matrix factorization framework to decompose cell type mixtures in ST data without using external single-cell expression references. RETROFIT outperforms existing reference-based methods in estimating cell type proportions and reconstructing gene expressions in simulations with varying spot size and sample heterogeneity, irrespective of the quality or availability of the single-cell reference. RETROFIT recapitulates known cell-type localization patterns in a Slide-seq dataset of mouse cerebellum without using any single-cell data.", "home": "https://bioconductor.org/packages/3.17/bioc/html/retrofit.html", "public": true, "access": "public", "owner": {"company": "", "location": "", "login": "bioconda", "name": "bioconda", "url": "", "description": "Bioconda is a distribution of bioinformatics software realized as a channel for the versatile Conda package manager.", "created_at": "2015-09-11 22:59:20.880000+00:00", "user_type": "org"}, "full_name": "bioconda/bioconductor-retrofit", "url": "http://api.anaconda.org/packages/bioconda/bioconductor-retrofit", "html_url": "http://anaconda.org/bioconda/bioconductor-retrofit", "versions": ["1.0.0", "1.2.0", "1.6.0", "1.10.0"], "latest_version": "1.10.0", "platforms": {"linux-64": "1.10.0", "osx-64": "1.6.0"}, "conda_platforms": ["linux-64", "osx-64"], "revision": 11, "license": "GPL-3.0-only", "license_url": null, "dev_url": null, "doc_url": null, "source_git_url": null, "source_git_tag": null, "app_entry": {}, "app_type": {}, "app_summary": {}, "builds": ["r43hc0ef7c4_1", "r43hc0ef7c4_0", "r44he5774e6_0", "r44h35d7169_0", "r43hf17093f_1", "r45ha27e39d_0", "r43hf17093f_0"], "ndownloads": 3076, "releases": [{"version": "1.0.0", "distributions": [], "full_name": "bioconda/bioconductor-ret